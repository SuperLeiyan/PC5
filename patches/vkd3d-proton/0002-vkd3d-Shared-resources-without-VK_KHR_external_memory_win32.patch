From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bornaradusin <bornaradusin@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:30:00 +0000
Subject: [PATCH] vkd3d: Shared resources without VK_KHR_external_memory_win32.

A shared resource's memory was made exportable as a Win32 handle and
exported at once (for D3DKMT), and CreateSharedHandle exported it again,
whether or not the driver has VK_KHR_external_memory_win32. The PS5's
RADV doesn't: vkGetMemoryWin32HandleKHR is NULL, and the call crashed
Unreal Engine 5 games that make a shared resource as they start
(STRETCHER.MEN). Without the extension the memory is an ordinary
allocation: the resource works, CreateSharedHandle returns E_NOTIMPL,
and a shared handle can't be opened. Shared fences, which need
VK_KHR_external_semaphore_win32, are kept from it the same way.
---
 libs/vkd3d/d3dkmt.c   |  8 ++++----
 libs/vkd3d/device.c   | 14 ++++++++++++++
 libs/vkd3d/resource.c | 20 ++++++++++++++++++--
 3 files changed, 36 insertions(+), 6 deletions(-)

diff --git a/libs/vkd3d/d3dkmt.c b/libs/vkd3d/d3dkmt.c
index 8fabb24..c6ccfd4 100644
--- a/libs/vkd3d/d3dkmt.c
+++ b/libs/vkd3d/d3dkmt.c
@@ -55,9 +55,9 @@ void d3d12_shared_fence_open_export_kmt(struct d3d12_shared_fence *fence, struct
     D3DKMT_OPENSYNCOBJECTFROMNTHANDLE open = {0};
     VkResult vr;
 
-    if (!device->kmt_local)
+    if (!device->kmt_local || !device->vk_info.KHR_external_semaphore_win32)
     {
-        /* D3DKMT API isn't supported */
+        /* D3DKMT API isn't supported, or the semaphore can't be exported */
         return;
     }
 
@@ -96,9 +96,9 @@ void d3d12_resource_open_export_kmt(struct d3d12_resource *resource, struct d3d1
     VkResult vr;
     char dummy;
 
-    if (!device->kmt_local)
+    if (!device->kmt_local || !device->vk_info.KHR_external_memory_win32)
     {
-        /* D3DKMT API isn't supported */
+        /* D3DKMT API isn't supported, or the memory can't be exported */
         return;
     }
 
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 4a630ff..f8798e6 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -7068,6 +7068,13 @@ static HRESULT STDMETHODCALLTYPE d3d12_device_CreateSharedHandle(d3d12_device_if
             return S_OK;
         }
 
+        if (!device->vk_info.KHR_external_memory_win32)
+        {
+            WARN("Can't share a resource without VK_KHR_external_memory_win32.\n");
+            ID3D12Resource_Release(resource_iface);
+            return E_NOTIMPL;
+        }
+
         if (attributes)
             FIXME("attributes %p not handled.\n", attributes);
         if (access)
@@ -7139,6 +7146,13 @@ static HRESULT STDMETHODCALLTYPE d3d12_device_CreateSharedHandle(d3d12_device_if
             return S_OK;
         }
 
+        if (!device->vk_info.KHR_external_semaphore_win32)
+        {
+            WARN("Can't share a fence without VK_KHR_external_semaphore_win32.\n");
+            ID3D12Fence_Release(fence_iface);
+            return E_NOTIMPL;
+        }
+
         if (attributes)
             FIXME("attributes %p not handled\n", attributes);
         if (access)
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 0fa8fb1..b7f9a9f 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -764,7 +764,8 @@ static HRESULT vkd3d_get_image_create_info(struct d3d12_device *device,
     memset(create_info, 0, sizeof(*create_info));
     image_info->sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
 
-    if (resource && (resource->heap_flags & D3D12_HEAP_FLAG_SHARED))
+    /* Without VK_KHR_external_memory_win32 a shared resource is an ordinary one (below). */
+    if (resource && (resource->heap_flags & D3D12_HEAP_FLAG_SHARED) && device->vk_info.KHR_external_memory_win32)
     {
         external_info->sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
         external_info->handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
@@ -4255,7 +4256,22 @@ HRESULT d3d12_resource_create_committed(struct d3d12_device *device, const D3D12
 #ifdef _WIN32
             dedicated_requirements.prefersDedicatedAllocation = VK_TRUE;
 
-            if (shared_handle && shared_handle != INVALID_HANDLE_VALUE)
+            /* A driver without VK_KHR_external_memory_win32 (the PS5's RADV) can neither
+             * export nor import Win32 handles: the memory of a new shared resource is an
+             * ordinary allocation, which CreateSharedHandle can't share, and a handle can't
+             * be opened. A game that only asks for a shared resource (Unreal Engine 5's)
+             * runs on; vkGetMemoryWin32HandleKHR isn't there to call. */
+            if (!device->vk_info.KHR_external_memory_win32)
+            {
+                if (shared_handle && shared_handle != INVALID_HANDLE_VALUE)
+                {
+                    WARN("Can't open a shared resource without VK_KHR_external_memory_win32.\n");
+                    hr = E_NOTIMPL;
+                    goto fail;
+                }
+                WARN("Shared resource without VK_KHR_external_memory_win32: it can't be shared.\n");
+            }
+            else if (shared_handle && shared_handle != INVALID_HANDLE_VALUE)
             {
                 import_info.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_WIN32_HANDLE_INFO_KHR;
                 import_info.pNext = allocate_info.pNext;
-- 
2.43.0

