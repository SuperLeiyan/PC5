diff --git a/wine/patches/0937-win32u-ps5-ordinary-memory-when-it-can-t-be-exported.patch b/wine/patches/0937-win32u-ps5-ordinary-memory-when-it-can-t-be-exported.patch
new file mode 100644
index 0000000..d0d6ea4
--- /dev/null
+++ b/wine/patches/0937-win32u-ps5-ordinary-memory-when-it-can-t-be-exported.patch
@@ -0,0 +1,42 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Thu, 29 Oct 2026 09:00:00 +0000
+Subject: [PATCH] win32u: Allocate memory a program asks to share as ordinary
+ memory when the PS5 can't export it.
+
+A program asking vkAllocateMemory for memory it can share as a Win32
+handle (VkExportMemoryAllocateInfo) has it exported through the host's
+VK_KHR_external_memory_fd. The PS5's RADV has no such extension, so the
+host handle type was 0, the export failed ("Unsupported handle type 0")
+and the allocation with it: DXVK, making a shared texture for an Unreal
+Engine 5 game on Direct3D 12 (STRETCHER.MEN), got no memory and the game
+crashed calling a null function.
+
+When the host can't export, the export request is dropped and the
+memory is an ordinary allocation, as on a driver that shares nothing;
+a handle for it can't be had.
+---
+diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
+--- a/dlls/win32u/vulkan.c
++++ b/dlls/win32u/vulkan.c
+@@ -893,6 +893,17 @@
+             export_info = (VkExportMemoryAllocateInfo *)*next;
+             if (!(export_info->handleTypes & EXTERNAL_MEMORY_WIN32_BITS))
+                 FIXME( "Unsupported handle types %#x\n", export_info->handleTypes );
++            else if (!get_host_external_memory_type())
++            {
++                /* The host can't export memory (no VK_KHR_external_memory_fd: the PS5's
++                 * RADV), so the memory can't be shared. It is an ordinary allocation
++                 * instead of a failed one, as on a driver that shares nothing: a program
++                 * that only asks for shareable memory (DXVK for a shared texture of an
++                 * Unreal Engine 5 game) runs on, and a handle for it can't be had. */
++                WARN( "Can't export memory for handle types %#x: an ordinary allocation\n", export_info->handleTypes );
++                *next = (*next)->pNext; next = &prev;
++                export_info = NULL;
++            }
+             else
+             {
+                 nt_shared = !(export_info->handleTypes & (VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT |
+-- 
+2.43.0
+
