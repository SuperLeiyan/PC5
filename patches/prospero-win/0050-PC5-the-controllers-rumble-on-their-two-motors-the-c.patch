From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bornaradusin <bornaradusin@users.noreply.github.com>
Date: Wed, 28 Oct 2026 18:00:00 +0000
Subject: [PATCH 50/50] PC5: the controllers' rumble on their two motors (the
 compatible vibration mode)

A DualSense opens in its advanced haptics mode, where the two motor
levels scePadSetVibration takes move nothing: the console answers 0 and
the controller stays still, while the adaptive triggers, set apart, still
play. pw_pad_ps5_open and pw_pad_ps5_open_user now set the compatible
mode (scePadSetVibrationMode(handle, 2)) once the controller is open, so
a game's XInput or DirectInput rumble reaches its motors, for every
player. The answer is kept (vibration_mode_rc) and logged with the first
rumble; a refusal leaves the controller working, without rumble, as
before. The same as prospero-win's own fix (pull request 695).
---
 native/pw_pad_ps5.c         | 18 +++++++++++++++---
 native/pw_pad_ps5.h         | 10 ++++++++++
 native/wine64_main.c        |  9 +++++----
 tests/test_pw_pad_ps5.c     | 20 +++++++++++++++++++-
 tests/test_pw_players_ps5.c |  2 +-
 5 files changed, 50 insertions(+), 9 deletions(-)

diff --git a/native/pw_pad_ps5.c b/native/pw_pad_ps5.c
index fdce104..eac9fab 100644
--- a/native/pw_pad_ps5.c
+++ b/native/pw_pad_ps5.c
@@ -20,6 +20,7 @@ extern int scePadRead(int32_t,PwPadPs5Data *,int32_t);
 extern int scePadClose(int32_t);
 extern int scePadSetVibration(int32_t,const uint8_t *);
 extern int scePadSetMotionSensorState(int32_t,_Bool);
+extern int scePadSetVibrationMode(int32_t,int32_t);
 /* At most four signed-in users; an empty place is -1. */
 typedef struct PwPadPs5LoginUsers { int32_t user_id[PW_PAD_PS5_USERS]; } PwPadPs5LoginUsers;
 extern int sceUserServiceGetLoginUserIdList(PwPadPs5LoginUsers *);
@@ -34,6 +35,7 @@ static int platform_pad_read(int32_t h,PwPadPs5Data *s,int32_t n)
 static int platform_pad_close(int32_t h){return scePadClose(h);}
 static int platform_pad_set_vibration(int32_t h,const uint8_t m[2]){return scePadSetVibration(h,m);}
 static int platform_pad_set_motion(int32_t h,int32_t on){return scePadSetMotionSensorState(h,on!=0);}
+static int platform_pad_set_vibration_mode(int32_t h,int32_t m){return scePadSetVibrationMode(h,m);}
 static int platform_login_users(int32_t users[])
 {
     PwPadPs5LoginUsers list;
@@ -53,7 +55,7 @@ int pw_pad_ps5_platform_ops(PwPadPs5Ops *ops)
     *ops=(PwPadPs5Ops){platform_user_initialize,platform_foreground_user,
         platform_user_terminate,platform_pad_init,platform_pad_open,
         platform_pad_read,platform_pad_close,platform_pad_set_vibration,platform_pad_set_motion,
-        platform_login_users};return PW_OK;
+        platform_login_users,platform_pad_set_vibration_mode};return PW_OK;
 #endif
 }
 
@@ -63,6 +65,16 @@ static int valid_ops(const PwPadPs5Ops *ops)
         ops->pad_init && ops->pad_open && ops->pad_read && ops->pad_close;
 }
 
+/* The controller's rumble on its two motors (the compatible mode), as
+ * XInput and DirectInput games ask for it. A refusal is kept, not fatal:
+ * the controller still reads, only without rumble. */
+static void compatible_vibration(PwPadPs5 *pad)
+{
+    pad->vibration_mode_rc=INT_MIN;
+    if(pad->ops.pad_set_vibration_mode)
+        pad->vibration_mode_rc=pad->ops.pad_set_vibration_mode(pad->pad_handle,PW_PAD_PS5_VIBRATION_COMPATIBLE);
+}
+
 static void centre_analog(PwPadPs5 *pad)
 {
     pad->left_stick=pad->right_stick=(PwPadPs5Stick){0x80,0x80};pad->l2=pad->r2=0;
@@ -85,7 +97,7 @@ int pw_pad_ps5_open(PwPadPs5 *pad,const PwPadPs5Ops *ops,
     pad->pad_init_rc=pad->ops.pad_init();if(pad->pad_init_rc<0)goto failed;
     pad->pad_handle=pad->ops.pad_open(pad->user_id,0,0,NULL);
     if(pad->pad_handle<0)goto failed;
-    pad->opened=1;centre_analog(pad);return PW_OK;
+    pad->opened=1;centre_analog(pad);compatible_vibration(pad);return PW_OK;
 failed:
     if(pad->owns_user_service){pad->terminate_rc=pad->ops.user_terminate();pad->owns_user_service=0;}
     return PW_ERR_STATE;
@@ -101,7 +113,7 @@ int pw_pad_ps5_open_user(PwPadPs5 *pad,const PwPadPs5Ops *ops,
     int status=pw_pad_init(&pad->core,map,map_count);if(status!=PW_OK)return status;
     pad->pad_handle=pad->ops.pad_open(user_id,0,0,NULL);
     if(pad->pad_handle<0)return PW_ERR_STATE;
-    pad->opened=1;centre_analog(pad);return PW_OK;
+    pad->opened=1;centre_analog(pad);compatible_vibration(pad);return PW_OK;
 }
 
 /* One native read converted to samples; count<0 reports a read error. */
diff --git a/native/pw_pad_ps5.h b/native/pw_pad_ps5.h
index 7da2ed0..e6f9043 100644
--- a/native/pw_pad_ps5.h
+++ b/native/pw_pad_ps5.h
@@ -32,12 +32,22 @@ typedef struct PwPadPs5Ops {
     /* Optional: the signed-in users (sceUserServiceGetLoginUserIdList),
      * PW_PAD_PS5_USERS of them, -1 for an empty place; NULL if none. */
     int (*login_users)(int32_t users[]);
+    /* Optional: scePadSetVibrationMode(handle, mode), NULL if none. A
+     * DualSense opens in its advanced haptics mode, where the two motor
+     * levels scePadSetVibration takes move nothing; the compatible mode
+     * plays them on its two motors. */
+    int (*pad_set_vibration_mode)(int32_t,int32_t);
 } PwPadPs5Ops;
 
+enum { PW_PAD_PS5_VIBRATION_ADVANCED=1,PW_PAD_PS5_VIBRATION_COMPATIBLE=2 };
+
 typedef struct PwPadPs5 {
     PwPad core;PwPadPs5Ops ops;int32_t user_id,pad_handle;
     int user_initialize_rc,pad_init_rc,close_rc,terminate_rc,last_read_rc;
     int vibration_rc,motion_rc;
+    /* What the console answered to the compatible vibration mode set as
+     * the controller opened (INT_MIN: not set, no call). */
+    int vibration_mode_rc;
     uint64_t polls,empty_reads,read_errors,connected_samples,disconnected_samples,
              intercepted_samples,generation_changes;
     uint8_t last_generation;
diff --git a/native/wine64_main.c b/native/wine64_main.c
