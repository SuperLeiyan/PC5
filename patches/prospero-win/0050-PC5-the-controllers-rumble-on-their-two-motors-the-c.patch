 #endif
                 int vibrate = pw_pad_ps5_vibrate(&pad, large, small);
                 if (!vibrations++ || vibrate != PW_OK)
-                    PS5LOG_LOG("PW_WINE64 rumble left=%u right=%u status=%s rc=%d", (unsigned)left,
-                               (unsigned)right, pw_result_name(vibrate), pad.vibration_rc);
+                    PS5LOG_LOG("PW_WINE64 rumble left=%u right=%u status=%s rc=%d mode_rc=%d", (unsigned)left,
+                               (unsigned)right, pw_result_name(vibrate), pad.vibration_rc, pad.vibration_mode_rc);
             }
         }
         /* Players 2 to 4: who is signed in, once a second; each one's
@@ -1794,8 +1794,9 @@ int main(int argc, char **argv)
 #endif
                     int vibrate = pw_pad_ps5_vibrate(extra, large, small);
                     if (!player_vibrations[place]++ || vibrate != PW_OK)
-                        PS5LOG_LOG("PW_WINE64 player %u rumble left=%u right=%u status=%s rc=%d", place + 1,
-                                   (unsigned)left, (unsigned)right, pw_result_name(vibrate), extra->vibration_rc);
+                        PS5LOG_LOG("PW_WINE64 player %u rumble left=%u right=%u status=%s rc=%d mode_rc=%d", place + 1,
+                                   (unsigned)left, (unsigned)right, pw_result_name(vibrate), extra->vibration_rc,
+                                   extra->vibration_mode_rc);
                 }
             }
         }
diff --git a/tests/test_pw_pad_ps5.c b/tests/test_pw_pad_ps5.c
index a8f01e4..59b2b32 100644
--- a/tests/test_pw_pad_ps5.c
+++ b/tests/test_pw_pad_ps5.c
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: LGPL-2.1-or-later */
 #include "../native/pw_pad_ps5.h"
 #include <assert.h>
+#include <limits.h>
 #include <string.h>
 
 static PwPadPs5Data fixture[64];static int fixture_count,read_rc,user_init_rc;
@@ -20,8 +21,10 @@ static int pad_set_vibration(int32_t h,const uint8_t m[2])
 {assert(h==7);vibration_calls++;memcpy(motors_seen,m,2);return vibration_rc;}
 static int motion_calls,motion_rc,motion_seen=-1;
 static int pad_set_motion(int32_t h,int32_t on){assert(h==7);motion_calls++;motion_seen=on;return motion_rc;}
+static int mode_calls,mode_rc,mode_seen=-1;
+static int pad_set_vibration_mode(int32_t h,int32_t m){assert(h==7);mode_calls++;mode_seen=m;return mode_rc;}
 static const PwPadPs5Ops ops={user_initialize,foreground,terminate,pad_init,pad_open,pad_read,pad_close,
-                              pad_set_vibration,pad_set_motion,NULL};
+                              pad_set_vibration,pad_set_motion,NULL,pad_set_vibration_mode};
 enum { CREATE=0x1,L1=0x400 };
 static const PwPadKeyMap map[]={{L1,'Z',0,0,"left-flipper"}};
 
@@ -31,6 +34,8 @@ int main(void)
     assert(pw_pad_ps5_open(&pad,&ops,map,1)==PW_OK && pad.opened && pad.pad_handle==7);
     assert(pad.left_stick.x==0x80 && pad.right_stick.y==0x80 && !pad.l2 && !pad.r2);
     assert(init_calls==1&&foreground_calls==1&&pad_init_calls==1&&open_calls==1);
+    /* Opened in the compatible vibration mode, once: the motor levels move its motors. */
+    assert(mode_calls==1&&mode_seen==PW_PAD_PS5_VIBRATION_COMPATIBLE&&pad.vibration_mode_rc==0);
     fixture[0]=(PwPadPs5Data){.buttons=L1|CREATE,.connected=1,.timestamp=1000,.connected_count=1};
     fixture_count=1;assert(pw_pad_ps5_read(&pad)==PW_OK);
     assert(pad.connected_samples==1 && pad.core.pressed_edges==(L1|CREATE));
@@ -111,5 +116,18 @@ int main(void)
     assert(pw_pad_ps5_close(&pad)==PW_OK && terminate_calls==1);
     assert(pw_pad_ps5_close(NULL)==PW_ERR_PRECONDITION);
     assert(pw_pad_ps5_read(&pad)==PW_ERR_PRECONDITION);
+    /* Refused, or no such call: the controller opens all the same. */
+    {
+        PwPadPs5 other;PwPadPs5Ops without=ops;
+        mode_rc=-5;assert(pw_pad_ps5_open(&other,&ops,map,1)==PW_OK&&other.opened&&other.vibration_mode_rc==-5);
+        pw_pad_ps5_close(&other);mode_rc=0;
+        without.pad_set_vibration_mode=NULL;int before=mode_calls;
+        assert(pw_pad_ps5_open(&other,&without,map,1)==PW_OK&&other.opened&&other.vibration_mode_rc==INT_MIN&&
+               mode_calls==before);
+        pw_pad_ps5_close(&other);
+        /* A second player's controller too. */
+        assert(pw_pad_ps5_open_user(&other,&ops,map,1,42)==PW_OK&&mode_calls==before+1&&other.vibration_mode_rc==0);
+        pw_pad_ps5_close(&other);
+    }
     return 0;
 }
