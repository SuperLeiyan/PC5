+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Wed, 28 Oct 2026 08:20:00 +0000
+Subject: [PATCH] dinput: List a PS5 title's controllers as XInput devices in
+ the registry.
+
+A game that leaves XInput devices to XInput tells them apart by the
+device manager's list, through WMI's Win32_PnPEntity (IsXInputDevice):
+a device whose instance id has IG_ and the vendor and product of the
+joystick's guidProduct. The title's joysticks were in no such list, so
+Batman: Arkham Knight took the controller for a joystick of another kind,
+which it doesn't play with, and never asked XInput for it. Each one found
+is listed now as Windows lists an Xbox 360 controller's HID device,
+HID\VID_045E&PID_028E&IG_0n\PS5&TITLE&n, in volatile keys.
+---
+ dlls/dinput/title_pad.c | 39 ++++++++++++++++++++++++++++++++++++++-
+ 1 file changed, 38 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/dinput/title_pad.c b/dlls/dinput/title_pad.c
+--- a/dlls/dinput/title_pad.c
++++ b/dlls/dinput/title_pad.c
+@@ -28,7 +28,9 @@
+  * the middle, the right one down), the D-pad a hat and ten buttons. As on
+  * Windows it has no force feedback, which games ask of XInput, and its path
+  * names it an XInput device (IG_), so a game that reads such controllers with
+- * XInput leaves it out here. The input thread reads it every few
++ * XInput leaves it out here. A game that tells them apart by the device
++ * manager's list instead (WMI's Win32_PnPEntity, as IsXInputDevice does)
++ * finds it there too, as an XInput device's HID device. The input thread reads it every few
+  * milliseconds while it is acquired, so buffered data and event notification
+  * work as for a HID joystick. winmm's joystick calls go through DirectInput
+  * and find it too. Anywhere but in a title the library finds no title and
+@@ -43,6 +45,7 @@
+ #include "winbase.h"
+ #include "winternl.h"
+ #include "winuser.h"
++#include "winreg.h"
+ #include "winerror.h"
+ #include "devguid.h"
+ #include "dinput.h"
+@@ -116,6 +119,39 @@ static BOOL read_title_pad( UINT32 index, struct xinput_pad_state *pad )
+     return TRUE;
+ }
+ 
++/* The player's controller in the device manager's list, as Windows lists an Xbox 360
++ * controller's HID device: its instance id names it an XInput device (IG_), with the
++ * vendor and product guidProduct has. A game that reads that list (WMI's Win32_PnPEntity
++ * reads these keys) to leave XInput devices to XInput, as Batman: Arkham Knight does, then
++ * plays it with XInput instead of taking it for a joystick of another kind. Volatile: the
++ * keys go with the title's session. */
++static void list_title_pad( UINT32 index )
++{
++    static const WCHAR hidclass[] = L"{745a17a0-74d3-11d0-b6fe-00a0c90f57da}";
++    static LONG listed;   /* a bit a player */
++    LONG bit = 1 << index;
++    WCHAR path[MAX_PATH];
++    HKEY key;
++    BOOL ok;
++
++    if (InterlockedOr( &listed, bit ) & bit) return;
++    swprintf( path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Enum\\HID\\VID_045E&PID_028E&IG_%02u\\PS5&TITLE&%u",
++              index, index );
++    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, REG_OPTION_VOLATILE, KEY_SET_VALUE, NULL, &key, NULL ))
++    {
++        WARN( "can't list player %u's controller as a device\n", index );
++        return;
++    }
++#define SET_STRING( name, value ) !RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)(value), sizeof(value) )
++    ok = SET_STRING( L"ClassGUID", hidclass ) && SET_STRING( L"Class", L"HIDClass" ) &&
++         SET_STRING( L"DeviceDesc", L"HID-compliant game controller" ) &&
++         SET_STRING( L"Mfg", L"(Standard system devices)" );
++#undef SET_STRING
++    RegCloseKey( key );
++    if (!ok) WARN( "player %u's controller listed without its values\n", index );
++    else TRACE( "player %u's controller listed as %s\n", index, debugstr_w( path ));
++}
++
+ static BOOL title_pad_index( const GUID *guid, UINT32 *index )
+ {
+     GUID base = *guid;
+@@ -134,6 +170,7 @@ HRESULT title_pad_enum_device( DWORD type, DWORD flags, DIDEVICEINSTANCEW *insta
+     TRACE( "type %#lx, flags %#lx, instance %p, version %#lx, index %d.\n", type, flags, instance, version, index );
+ 
+     if (index < 0 || !read_title_pad( index, &pad )) return DIERR_DEVICENOTREG;
++    list_title_pad( index );
+ 
+     size = instance->dwSize;
+     memset( instance, 0, size );
+-- 
+2.43.0
+
