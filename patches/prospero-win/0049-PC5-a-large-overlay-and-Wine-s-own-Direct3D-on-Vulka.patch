     PW_PC5_HUD_ALL = 63u,
+    /* Not a line: the lines in twice the size, two at a time, taking turns every
+     * PW_PC5_HUD_TURN_S seconds when more are on (Settings › Overlay › Size). */
+    PW_PC5_HUD_LARGE = 64u,
+    PW_PC5_HUD_FLAGS = 127u,     /* the lines and LARGE */
     PW_PC5_HUD_LINES = 6,
     PW_PC5_HUD_PITCH = 9,        /* a line: 7 rows of glyph and 2 of space */
+    PW_PC5_HUD_LARGE_PITCH = 30, /* a large line: its value 14 rows high, its label 7 under it */
