diff --git a/wine/ps5/pw_pc5_hud.h b/wine/ps5/pw_pc5_hud.h
index f24d227..547ff64 100644
--- a/wine/ps5/pw_pc5_hud.h
+++ b/wine/ps5/pw_pc5_hud.h
@@ -95,8 +95,14 @@ enum {
     PW_PC5_HUD_SOC_TEMP = 16u,
