@@ -426,6 +427,7 @@ void pw_pc5_hud_tick(void)
             stats.frame_us = frames ? (uint32_t)((elapsed / frames + 500) / 1000) : 0;
             pc5.second_at = now;
             pc5.second_flips = pc5.flips;
