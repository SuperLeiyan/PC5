+    unsigned seconds;            /* updates so far, a second apart: which lines a large overlay shows */
 } PwPc5HudStats;
 
 /* A glyph of the overlay's lines: its width (1 to 5 columns, bit width-1
@@ -118,6 +125,7 @@ static inline int pw_pc5_hud_line_glyph(char c, const uint8_t **rows)
         { 'A', 5, { 0x0e, 0x11, 0x11, 0x1f, 0x11, 0x11, 0x11 } },
         { 'C', 5, { 0x0e, 0x11, 0x10, 0x10, 0x10, 0x11, 0x0e } },
         { 'F', 5, { 0x1f, 0x10, 0x10, 0x1e, 0x10, 0x10, 0x10 } },
+        { 'G', 5, { 0x0e, 0x11, 0x10, 0x17, 0x11, 0x11, 0x0f } },
         { 'M', 5, { 0x11, 0x1b, 0x15, 0x15, 0x11, 0x11, 0x11 } },
         { 'O', 5, { 0x0e, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0e } },
         { 'P', 5, { 0x1e, 0x11, 0x11, 0x1e, 0x10, 0x10, 0x10 } },
@@ -172,6 +180,32 @@ static inline void pw_pc5_hud_text(uint32_t *image, int x, int y, const char *te
     }
 }
 
+/* How wide text is in the line glyphs at scale times their size. */
+static inline int pw_pc5_hud_text_width_scaled(const char *text, int scale)
+{
+    return pw_pc5_hud_text_width(text) * scale;
+}
+
+/* text in the line glyphs, each pixel a scale x scale square. */
+static inline void pw_pc5_hud_text_scaled(uint32_t *image, int x, int y, const char *text, int scale, uint32_t color)
+{
+    for (const char *p = text; *p; p++) {
+        const uint8_t *rows;
+        int w = pw_pc5_hud_line_glyph(*p, &rows);
+        if (!w) continue;
+        for (int row = 0; row < 7; row++)
+            for (int column = 0; column < w; column++)
+                if (rows[row] & (1u << (w - 1 - column)))
+                    for (int dy = 0; dy < scale; dy++)
+                        for (int dx = 0; dx < scale; dx++) {
+                            int px = x + column * scale + dx, py = y + row * scale + dy;
+                            if (px >= 0 && px < PW_PC5_HUD_SIDE && py >= 0 && py < PW_PC5_HUD_SIDE)
+                                image[py * PW_PC5_HUD_SIDE + px] = color;
+                        }
+        x += (w + 1) * scale;
+    }
+}
+
 /* A decimal with one digit after the point, from tenths. */
 static inline void pw_pc5_hud_tenths(char *out, size_t size, uint64_t tenths, int point)
 {
@@ -281,10 +315,62 @@ static inline uint32_t pw_pc5_hud_draw_lines(uint32_t *image, const PwPc5HudStat
     return height;
 }
 
+/* A dark box h rows high at the top of the image, its corners rounded to radius r. */
+static inline void pw_pc5_hud_box(uint32_t *image, uint32_t h, int r)
+{
+    for (uint32_t y = 0; y < h; y++)
+        for (uint32_t x = 0; x < PW_PC5_HUD_SIDE; x++) {
+            int cx = x < (uint32_t)r ? r - (int)x : x > PW_PC5_HUD_SIDE - 1 - (uint32_t)r ? (int)x - (PW_PC5_HUD_SIDE - 1 - r) : 0;
+            int cy = y < (uint32_t)r ? r - (int)y : y > h - 1 - (uint32_t)r ? (int)y - (int)(h - 1 - r) : 0;
+            if (cx * cx + cy * cy <= r * r) image[y * PW_PC5_HUD_SIDE + x] = 0xc0101216u;
+        }
+}
+
+/* The large overlay (PW_PC5_HUD_LARGE): up to two lines, each its value in glyphs twice the
+ * size over its label, centred; with more lines on, the next two every PW_PC5_HUD_TURN_S
+ * seconds. The memory shows the gigabytes used ("5.1G"), the whole being too wide at that
+ * size. The box's height, 0 when no line is shown. */
+static inline uint32_t pw_pc5_hud_draw_large(uint32_t *image, const PwPc5HudStats *stats)
+{
+    static const unsigned order[PW_PC5_HUD_LINES] = { PW_PC5_HUD_FPS, PW_PC5_HUD_FRAME_TIME, PW_PC5_HUD_CPU,
+                                                      PW_PC5_HUD_CPU_TEMP, PW_PC5_HUD_SOC_TEMP, PW_PC5_HUD_MEMORY };
+    const char *labels[PW_PC5_HUD_LINES];
+    char values[PW_PC5_HUD_LINES][24];
+    unsigned count = 0, first, shown;
+    uint32_t height;
+
+    memset(image, 0, PW_PC5_HUD_SIDE * PW_PC5_HUD_SIDE * 4);
+    for (unsigned i = 0; i < PW_PC5_HUD_LINES; i++) {
+        if (!pw_pc5_hud_line(stats, order[i], &labels[count], values[count], sizeof(values[count]))) continue;
+        if (order[i] == PW_PC5_HUD_MEMORY) {
+            uint64_t tenths = (stats->memory_used * 10 + ((uint64_t)1 << 29)) >> 30;
+            pw_pc5_hud_tenths(values[count], sizeof(values[count]) - 1, tenths > 999 ? tenths / 10 * 10 : tenths,
+                              tenths <= 999);
+            strcat(values[count], "G");
+        }
+        count++;
+    }
+    if (!count) return 0;
+    first = count > 2 ? (stats->seconds / PW_PC5_HUD_TURN_S * 2) % ((count + 1) / 2 * 2) : 0;
+    shown = count - first < 2 ? count - first : 2;
+    height = 2 + shown * PW_PC5_HUD_LARGE_PITCH + 2;
+    pw_pc5_hud_box(image, height, 8);
+    for (unsigned i = 0; i < shown; i++) {
+        const char *value = values[first + i], *label = labels[first + i];
+        int y = 3 + (int)i * PW_PC5_HUD_LARGE_PITCH, scale = pw_pc5_hud_text_width_scaled(value, 2) <= PW_PC5_HUD_SIDE - 4 ? 2 : 1;
+        pw_pc5_hud_text_scaled(image, (PW_PC5_HUD_SIDE - pw_pc5_hud_text_width_scaled(value, scale)) / 2,
+                               y + (scale == 2 ? 0 : 4), value, scale, 0xffffffffu);
+        pw_pc5_hud_text(image, (PW_PC5_HUD_SIDE - pw_pc5_hud_text_width(label)) / 2, y + 17, label, 0xff9aa3afu);
+    }
+    return height;
+}
+
 /* The overlay for stats: the large counter for FPS alone (its box's
- * height), else the lines. */
+ * height), the large lines when LARGE is on, else the lines. */
 static inline uint32_t pw_pc5_hud_draw_stats(uint32_t *image, const PwPc5HudStats *stats)
 {
+    if ((stats->lines & PW_PC5_HUD_ALL) != PW_PC5_HUD_FPS && (stats->lines & PW_PC5_HUD_LARGE))
+        return pw_pc5_hud_draw_large(image, stats);
     if ((stats->lines & PW_PC5_HUD_ALL) == PW_PC5_HUD_FPS) {
         pw_pc5_hud_draw(image, stats->fps);
         return PW_PC5_HUD_BOX_HEIGHT;
