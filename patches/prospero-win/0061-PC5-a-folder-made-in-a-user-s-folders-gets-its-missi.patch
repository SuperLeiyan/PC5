new file mode 100644
index 0000000..85d9d68
--- /dev/null
+++ b/wine/patches/0940-ntdll-ps5-make-the-missing-parents-of-a-folder-in-a-user-s-folders.patch
@@ -0,0 +1,90 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 30 Oct 2026 10:00:00 +0000
+Subject: [PATCH] ntdll: Make the missing parents of a folder made in a user's folders on PS5.
+
+A game copied from a PC was never installed on the console, so the
+folders its installer made in the user's own folders aren't there. Call
+of Juarez Gunslinger's engine makes
+AppData\Local\Techland\COJGunslinger, whose Techland its installer
+makes, and stops with an uncaught C++ exception when that fails
+(STATUS_OBJECT_PATH_NOT_FOUND). A folder made, or opened if there, as a
+folder by its full name under C:\users\<name>\ whose parent isn't there
+now gets its missing parents first, one at a time, the same way, and is
+then made. The users folder and a user's own folder are never made;
+nothing outside the users' folders changes. Each parent made is logged.
+---
+diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
+--- a/dlls/ntdll/unix/file.c
++++ b/dlls/ntdll/unix/file.c
+@@ -4850,6 +4850,47 @@ NTSTATUS open_unix_file( HANDLE *handle, const char *unix_name, ACCESS_MASK acce
+ /******************************************************************************
+  *              NtCreateFile   (NTDLL.@)
+  */
++#ifdef __PROSPERO__
++/* A folder a program makes in a user's own folders (C:\users\<name>\...) whose parent isn't
++ * there: its missing parents are made first, as the program's installer would have made them
++ * on Windows. A game copied from a PC was never installed here: Call of Juarez Gunslinger's
++ * engine makes AppData\Local\Techland\COJGunslinger, whose Techland its installer makes, and
++ * stops when that fails. Only a folder made or opened as one, by its full name, and never the
++ * users folder or a user's own: TRUE when the parent is there now. */
++static BOOL ps5_make_parent( const OBJECT_ATTRIBUTES *attr )
++{
++    static const char users[] = "\\??\\c:\\users\\";
++    const UNICODE_STRING *name = attr->ObjectName;
++    USHORT len = name->Length / sizeof(WCHAR), n = sizeof(users) - 1, i, cut = 0, inside = 0;
++    OBJECT_ATTRIBUTES parent_attr;
++    UNICODE_STRING parent;
++    IO_STATUS_BLOCK io;
++    HANDLE parent_handle;
++
++    if (attr->RootDirectory || !name->Buffer || len <= n) return FALSE;
++    for (i = 0; i < n; i++)
++    {
++        WCHAR c = name->Buffer[i];
++        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
++        if (c != (unsigned char)users[i]) return FALSE;
++    }
++    for (i = len; i > n; i--)
++        if (name->Buffer[i - 1] == '\\') { cut = i - 1; break; }
++    for (i = n; i < cut; i++) inside += name->Buffer[i] == '\\';
++    if (!cut || !inside) return FALSE;   /* the parent is a user's own folder: never made here */
++    parent.Buffer = name->Buffer;
++    parent.Length = parent.MaximumLength = cut * sizeof(WCHAR);
++    InitializeObjectAttributes( &parent_attr, &parent, attr->Attributes, 0, NULL );
++    if (NtCreateFile( &parent_handle, FILE_LIST_DIRECTORY | SYNCHRONIZE, &parent_attr, &io, NULL,
++                      FILE_ATTRIBUTE_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
++                      FILE_OPEN_IF, FILE_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT, NULL, 0 ))
++        return FALSE;
++    NtClose( parent_handle );
++    if (io.Information == FILE_CREATED) ERR( "made %s, which %s is in\n", debugstr_us(&parent), debugstr_us(name) );
++    return TRUE;
++}
++#endif
++
+ NTSTATUS WINAPI NtCreateFile( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBUTES *attr,
+                               IO_STATUS_BLOCK *io, LARGE_INTEGER *alloc_size,
+                               ULONG attributes, ULONG sharing, ULONG disposition,
+@@ -4884,6 +4925,19 @@ NTSTATUS WINAPI NtCreateFile( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBU
+     }
+     else status = get_nt_and_unix_names( &new_attr, &nt_name, &unix_name, disposition,
+                                          options & FILE_OPEN_REPARSE_POINT );
++#ifdef __PROSPERO__
++    if (status == STATUS_OBJECT_PATH_NOT_FOUND && (options & FILE_DIRECTORY_FILE) &&
++        !(options & FILE_OPEN_BY_FILE_ID) && (disposition == FILE_CREATE || disposition == FILE_OPEN_IF) &&
++        ps5_make_parent( attr ))
++    {
++        free( unix_name );
++        free( nt_name.Buffer );
++        unix_name = NULL;
++        new_attr = *attr;
++        status = get_nt_and_unix_names( &new_attr, &nt_name, &unix_name, disposition,
++                                        options & FILE_OPEN_REPARSE_POINT );
++    }
++#endif
+ 
+     if (status == STATUS_BAD_DEVICE_TYPE)
+     {
+-- 
