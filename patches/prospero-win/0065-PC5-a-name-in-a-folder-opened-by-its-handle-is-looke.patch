+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 30 Oct 2026 17:00:00 +0000
+Subject: [PATCH] ntdll: Look a name up in a root directory by its name when its descriptor can't be used on PS5.
+
+A name opened relative to a directory handle (OBJECT_ATTRIBUTES'
+RootDirectory) was looked up in the descriptor the in-process server
+gave for the handle, which this module's working-directory emulation
+knows no path for: fstatat and openat failed with EBADF, and the open
+with STATUS_INVALID_HANDLE. .NET's FileSystemEnumerator opens each
+subfolder that way, so a game's folder with subfolders couldn't be
+listed (Heroes of Might and Magic: Olden Era, StreamingAssets\maps\
+Story_maps, "invalid handle" after patches 0936 and 0938). As patch
+0936 enters such a directory, the name is now looked up from the
+directory's own name, the one the server opened it with or its NT
+name's, as a name without a root directory is; logged the first time.
+---
+diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
+--- a/dlls/ntdll/unix/file.c
++++ b/dlls/ntdll/unix/file.c
+@@ -4072,6 +4072,35 @@ static NTSTATUS nt_to_unix_file_name( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *n
+             status = lookup_unix_name( root_fd, attr, nt_name, 0, &unix_name, unix_len,
+                                        1, disposition, open_reparse, FALSE, 0 );
+             if (needs_close) close( root_fd );
++            /* The descriptor came from the in-process server, and this module's
++             * working-directory emulation knows no path for it, so a name can't be
++             * looked up in it (EBADF), as patch 0936 found for listing it: the name is
++             * looked up from the directory's own, the one the server opened it with or
++             * its NT name's, as a name without a root directory is. */
++#ifdef __PROSPERO__
++            if (status == STATUS_INVALID_HANDLE)
++            {
++                static LONG logged;
++                char *root_name = NULL, *full;
++                int root_len;
++
++                if ((!server_get_unix_name( attr->RootDirectory, &root_name ) ||
++                     (root_name = unix_name_from_nt_name( attr->RootDirectory ))) &&
++                    (root_len = strlen( root_name )) && (full = malloc( root_len + unix_len )))
++                {
++                    memcpy( full, root_name, root_len + 1 );
++                    if (root_len > 1 && full[root_len - 1] == '/') full[--root_len] = 0;
++                    free( unix_name );
++                    unix_name = full;
++                    status = lookup_unix_name( AT_FDCWD, attr, nt_name, 0, &unix_name, root_len + unix_len,
++                                               root_len, disposition, open_reparse, FALSE, 0 );
++                }
++                if (!InterlockedExchange( &logged, 1 ))
++                    ERR( "wine-ps5: %s looked up in directory %s by its name, not its descriptor: status %#x\n",
++                         debugstr_us(attr->ObjectName), debugstr_a(root_name), (int)status );
++                free( root_name );
++            }
++#endif
+         }
+     }
+     else if (status == STATUS_OBJECT_TYPE_MISMATCH) status = STATUS_BAD_DEVICE_TYPE;
+-- 
+2.43.0
+
