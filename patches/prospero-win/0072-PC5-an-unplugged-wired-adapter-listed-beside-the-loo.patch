+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sat, 31 Oct 2026 01:00:00 +0000
+Subject: [PATCH] nsi: PS5: list a wired adapter with its cable out beside the
+ loopback interface.
+
+Patch 0934 answers NSI requests without nsiproxy.sys with the loopback
+interface alone. GetAdaptersInfo leaves the loopback out, so it failed
+with ERROR_NO_DATA, as on a PC with no network adapter at all. Games
+that read their adapter's address from it without checking the error
+went through a list it never filled: Splinter Cell Conviction crashed
+reading IP_ADAPTER_INFO.Index through a pointer made of leftover text,
+about 13 seconds in, and stopped drawing.
+
+The NDIS tables (the interface table and the index-to-LUID map) now
+list a second interface, a wired one with its cable out, as a PC whose
+network is unplugged has: "Ethernet", index 2, a fixed locally
+administered address (02-50-43-35-00-01), down and disconnected. It has
+no IPv4 or IPv6 interface or address, so GetAdaptersInfo lists it with
+0.0.0.0 and GetAdaptersAddresses shows it down: a game sees itself
+offline, as it is. The tables now list as many rows as they keep, and a
+listing with room for fewer fails as nsiproxy.sys's does.
+---
+diff --git a/dlls/nsi/nsi.c b/dlls/nsi/nsi.c
+index 865ca78..4a87d08 100644
+--- a/dlls/nsi/nsi.c
++++ b/dlls/nsi/nsi.c
+@@ -75,7 +75,13 @@ static inline HANDLE get_nsi_device( BOOL async )
+  * as Windows names it.  The tables it has no row in (routes, neighbours,
+  * TCP and UDP endpoints...) list none; a get of another key fails as
+  * nsiproxy.sys's does, and of a table not kept here with ERROR_NOT_FOUND.
+- * Change notifications still fail.  With the device nothing changes. */
++ * Change notifications still fail.  With the device nothing changes.
++ * The NDIS tables also list a wired adapter with its cable out, as a PC
++ * whose network is unplugged has: GetAdaptersInfo, which leaves the
++ * loopback out, failed with ERROR_NO_DATA with no other adapter, and games
++ * that read their adapter's address from it without checking went through
++ * a list it never filled and crashed.  It has a fixed address and none of
++ * IPv4 or IPv6, so a game sees itself offline, as it is. */
+ 
+ #define NSI_FALLBACK_MS_MODULEID(n) { sizeof(NPI_MODULEID), MIT_GUID, { { 0xeb004a00 + (n), 0x9b1a, 0x11d4, \
+                                       { 0x91, 0x23, 0x00, 0x50, 0x04, 0x77, 0x59, 0xbc } } } }
+@@ -86,22 +92,32 @@ static const NPI_MODULEID nsi_fallback_ipv6_moduleid = NSI_FALLBACK_MS_MODULEID(
+ static const NPI_MODULEID nsi_fallback_ndis_moduleid = NSI_FALLBACK_MS_MODULEID( 0x11 );
+ 
+ #define LOOPBACK_IF_INDEX       1
++#define ETHERNET_IF_INDEX       2
++#define NDIS_ROWS               2  /* the loopback's, then the wired adapter's */
+ #define LOOPBACK_MTU            1500  /* nsiproxy.sys has the Unix MTU, 65536 for Linux's lo */
+ #define LOOPBACK_REACHABLE_TIME 30000 /* ms: Linux's default base_reachable_time_ms, which nsiproxy.sys reads */
+ 
+ static const IN_ADDR loopback_ipv4_addr = { { { 127, 0, 0, 1 } } };
+ static const IN6_ADDR loopback_ipv6_addr = { { IN6ADDR_LOOPBACK_INIT } };
+ 
+-static NET_LUID loopback_luid( void )
++/* locally administered, so it is no maker's: 02-50-43-35-00-01 ("PC5") */
++static const BYTE ethernet_address[6] = { 0x02, 'P', 'C', '5', 0x00, 0x01 };
++
++static NET_LUID ndis_luid( UINT row )
+ {
+     NET_LUID luid;
+ 
+     luid.Value = 0;
+-    luid.Info.NetLuidIndex = LOOPBACK_IF_INDEX;
+-    luid.Info.IfType = MIB_IF_TYPE_LOOPBACK;
++    luid.Info.NetLuidIndex = row ? ETHERNET_IF_INDEX : LOOPBACK_IF_INDEX;
++    luid.Info.IfType = row ? MIB_IF_TYPE_ETHERNET : MIB_IF_TYPE_LOOPBACK;
+     return luid;
+ }
+ 
++static NET_LUID loopback_luid( void )
++{
++    return ndis_luid( 0 );
++}
++
+ static void loopback_string( IF_COUNTED_STRING *str, const WCHAR *value )
+ {
+     memset( str, 0, sizeof(*str) );
+@@ -109,45 +125,63 @@ static void loopback_string( IF_COUNTED_STRING *str, const WCHAR *value )
+     memcpy( str->String, value, str->Length );
+ }
+ 
+-/* ndis.c's ifinfo_fill_entry() for lo, with Windows's alias and description */
+-static void ifinfo_fill( void *key, void *rw_data, void *dynamic_data, void *static_data )
++/* ndis.c's ifinfo_fill_entry() for lo and for a wired adapter whose cable is
++ * out, with Windows's aliases and descriptions */
++static void ifinfo_fill( UINT row, void *key, void *rw_data, void *dynamic_data, void *static_data )
+ {
+-    static const GUID guid = { LOOPBACK_IF_INDEX, 0, 0, { 0, 0, 'N', 'e', 't', 'D', 'e', 'v' } };
+     struct nsi_ndis_ifinfo_rw *rw = rw_data;
+     struct nsi_ndis_ifinfo_dynamic *dyn = dynamic_data;
+     struct nsi_ndis_ifinfo_static *stat = static_data;
+-    NET_LUID luid = loopback_luid();
++    NET_LUID luid = ndis_luid( row );
++    UINT index = luid.Info.NetLuidIndex;
++    GUID guid = { index, 0, 0, { 0, 0, 'N', 'e', 't', 'D', 'e', 'v' } };
+ 
+     if (key) memcpy( key, &luid, sizeof(luid) );
+     if (rw)
+     {
+-        memset( rw, 0, sizeof(*rw) ); /* no network guid, physical address or second name */
++        memset( rw, 0, sizeof(*rw) ); /* no network guid or second name */
+         rw->admin_status = MIB_IF_ADMIN_STATUS_UP;
+-        loopback_string( &rw->alias, L"Loopback Pseudo-Interface 1" );
++        loopback_string( &rw->alias, row ? L"Ethernet" : L"Loopback Pseudo-Interface 1" );
++        if (row)
++        {
++            rw->phys_addr.Length = sizeof(ethernet_address);
++            memcpy( rw->phys_addr.Address, ethernet_address, sizeof(ethernet_address) );
++        }
+     }
+     if (dyn)
+     {
+         memset( dyn, 0, sizeof(*dyn) ); /* no flags and no traffic */
+-        dyn->oper_status = IfOperStatusUp;
+-        dyn->media_conn_state = MediaConnectStateConnected;
++        dyn->oper_status = row ? IfOperStatusDown : IfOperStatusUp;
++        dyn->media_conn_state = row ? MediaConnectStateDisconnected : MediaConnectStateConnected;
+         dyn->mtu = LOOPBACK_MTU;
+         dyn->xmit_speed = dyn->rcv_speed = 1000000; /* as on Linux: some programs want at least that */
+     }
+     if (stat)
+     {
+-        memset( stat, 0, sizeof(*stat) ); /* no connector, physical address, flags or media type */
+-        stat->if_index = LOOPBACK_IF_INDEX;
+-        loopback_string( &stat->descr, L"Software Loopback Interface 1" );
+-        stat->type = MIB_IF_TYPE_LOOPBACK;
+-        stat->access_type = NET_IF_ACCESS_LOOPBACK;
++        memset( stat, 0, sizeof(*stat) ); /* no flags but hw, and no media type */
++        stat->if_index = index;
++        loopback_string( &stat->descr, row ? L"Ethernet Adapter" : L"Software Loopback Interface 1" );
++        stat->type = luid.Info.IfType;
++        stat->access_type = row ? NET_IF_ACCESS_BROADCAST : NET_IF_ACCESS_LOOPBACK;
+         stat->conn_type = NET_IF_CONNECTION_DEDICATED;
+         stat->if_guid = guid;
++        if (row)
++        {
++            stat->conn_present = 1;
++            stat->perm_phys_addr.Length = sizeof(ethernet_address);
++            memcpy( stat->perm_phys_addr.Address, ethernet_address, sizeof(ethernet_address) );
++            stat->flags.hw = 1;
++        }
+     }
+ }
+ 
+-static BOOL ifinfo_is_loopback( const void *key )
++static int ifinfo_row( const void *key )
+ {
+-    return ((const NET_LUID *)key)->Value == loopback_luid().Value;
++    UINT row;
++
++    for (row = 0; row < NDIS_ROWS; row++)
++        if (((const NET_LUID *)key)->Value == ndis_luid( row ).Value) return row;
++    return -1;
+ }
+ 
+ static DWORD ifinfo_get_parameter( const void *key, UINT type, void *data, UINT data_size, UINT data_offset )
+@@ -157,22 +191,25 @@ static DWORD ifinfo_get_parameter( const void *key, UINT type, void *data, UINT
+         struct nsi_ndis_ifinfo_rw rw;
+         struct nsi_ndis_ifinfo_dynamic dyn;
+         struct nsi_ndis_ifinfo_static stat;
+-    } row;
++    } entry;
++    int row = ifinfo_row( key );
+ 
+-    if (!ifinfo_is_loopback( key )) return ERROR_FILE_NOT_FOUND;
+-    ifinfo_fill( NULL, type == NSI_PARAM_TYPE_RW ? &row.rw : NULL, type == NSI_PARAM_TYPE_DYNAMIC ? &row.dyn : NULL,
+-                 type == NSI_PARAM_TYPE_STATIC ? &row.stat : NULL );
+-    memcpy( data, (BYTE *)&row + data_offset, data_size );
++    if (row < 0) return ERROR_FILE_NOT_FOUND;
++    ifinfo_fill( row, NULL, type == NSI_PARAM_TYPE_RW ? &entry.rw : NULL,
++                 type == NSI_PARAM_TYPE_DYNAMIC ? &entry.dyn : NULL, type == NSI_PARAM_TYPE_STATIC ? &entry.stat : NULL );
++    memcpy( data, (BYTE *)&entry + data_offset, data_size );
+     return ERROR_SUCCESS;
+ }
+ 
+ /* ndis.c's index_luid_get_parameter() */
+ static DWORD index_luid_get_parameter( const void *key, UINT type, void *data, UINT data_size, UINT data_offset )
+ {
+-    NET_LUID luid = loopback_luid();
++    UINT index = *(const UINT *)key;
++    NET_LUID luid;
+ 
+     if (type != NSI_PARAM_TYPE_STATIC || data_size != sizeof(luid) || data_offset) return ERROR_INVALID_PARAMETER;
+-    if (*(const UINT *)key != LOOPBACK_IF_INDEX) return ERROR_FILE_NOT_FOUND;
++    if (index != LOOPBACK_IF_INDEX && index != ETHERNET_IF_INDEX) return ERROR_FILE_NOT_FOUND;
++    luid = ndis_luid( index == ETHERNET_IF_INDEX );
+     memcpy( data, &luid, sizeof(luid) );
+     return ERROR_SUCCESS;
+ }
+@@ -206,19 +243,19 @@ static void ip_interface_fill( BOOL ipv6, void *key, struct nsi_ip_interface_rw
+     if (stat) memset( stat, 0, sizeof(*stat) );
+ }
+ 
+-static void ipv4_interface_fill( void *key, void *rw, void *dyn, void *stat )
++static void ipv4_interface_fill( UINT row, void *key, void *rw, void *dyn, void *stat )
+ {
+     ip_interface_fill( FALSE, key, rw, dyn, stat );
+ }
+ 
+-static void ipv6_interface_fill( void *key, void *rw, void *dyn, void *stat )
++static void ipv6_interface_fill( UINT row, void *key, void *rw, void *dyn, void *stat )
+ {
+     ip_interface_fill( TRUE, key, rw, dyn, stat );
+ }
+ 
+-static BOOL ip_interface_is_loopback( const void *key )
++static int ip_interface_row( const void *key )
+ {
+-    return ((const struct nsi_ip_interface_key *)key)->luid.Value == loopback_luid().Value;
++    return ((const struct nsi_ip_interface_key *)key)->luid.Value == loopback_luid().Value ? 0 : -1;
+ }
+ 
+ /* ip.c's unicast_fill_entry() for lo's 127.0.0.1/8 and ::1/128 */
+@@ -248,7 +285,7 @@ static void unicast_fill( UINT prefix_len, struct nsi_ip_unicast_rw *rw, struct
+     }
+ }
+ 
+-static void ipv4_unicast_fill( void *key_data, void *rw, void *dyn, void *stat )
++static void ipv4_unicast_fill( UINT row, void *key_data, void *rw, void *dyn, void *stat )
+ {
+     struct nsi_ipv4_unicast_key *key = key_data;
+ 
+@@ -261,14 +298,14 @@ static void ipv4_unicast_fill( void *key_data, void *rw, void *dyn, void *stat )
+     unicast_fill( 8, rw, dyn, stat );
+ }
+ 
+-static BOOL ipv4_unicast_is_loopback( const void *key_data )
++static int ipv4_unicast_row( const void *key_data )
+ {
+     const struct nsi_ipv4_unicast_key *key = key_data;
+ 
+-    return key->luid.Value == loopback_luid().Value && key->addr.s_addr == loopback_ipv4_addr.s_addr;
++    return key->luid.Value == loopback_luid().Value && key->addr.s_addr == loopback_ipv4_addr.s_addr ? 0 : -1;
+ }
+ 
+-static void ipv6_unicast_fill( void *key_data, void *rw, void *dyn, void *stat )
++static void ipv6_unicast_fill( UINT row, void *key_data, void *rw, void *dyn, void *stat )
+ {
+     struct nsi_ipv6_unicast_key *key = key_data;
+ 
+@@ -280,11 +317,12 @@ static void ipv6_unicast_fill( void *key_data, void *rw, void *dyn, void *stat )
+     unicast_fill( 128, rw, dyn, stat );
+ }
+ 
+-static BOOL ipv6_unicast_is_loopback( const void *key_data )
++static int ipv6_unicast_row( const void *key_data )
