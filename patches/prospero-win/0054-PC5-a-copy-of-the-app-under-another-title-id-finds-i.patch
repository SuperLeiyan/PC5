diff --git a/tests/test_pw_title_id.c b/tests/test_pw_title_id.c
new file mode 100644
index 0000000..e816f3d
--- /dev/null
+++ b/tests/test_pw_title_id.c
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../native/pw_title_id.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static int parse(const char *text, char out[PW_TITLE_ID_SIZE])
+{
+    return pw_title_id_parse(text, strlen(text), out);
+}
+
+static void test_parse(void)
+{
+    char id[PW_TITLE_ID_SIZE];
+
+    /* As PC5 and the PS5 Forwarder Format write it, the id near the end. */
+    assert(!parse("{\n  \"conceptId\": \"99437\",\n  \"contentId\": \"UP0000-PPSA99437_00-PC5TILE000000000\",\n"
+                  "  \"titleId\": \"PPSA99437\",\n  \"versionFileUri\": \"\"\n}\n", id) &&
+           !strcmp(id, "PPSA99437"));
+    /* Without spaces, with tabs and CRLF. */
+    assert(!parse("{\"titleId\":\"PPSA11018\"}", id) && !strcmp(id, "PPSA11018"));
+    assert(!parse("{\r\n\t\"titleId\"\t:\r\n\t\"CUSA00001\"\r\n}", id) && !strcmp(id, "CUSA00001"));
+    /* A key that only starts the same, then the real one. */
+    assert(!parse("{\"titleIdOld\": \"PPSA00001\", \"titleId\": \"PPSA00002\"}", id) && !strcmp(id, "PPSA00002"));
+    /* The id inside another value isn't the title's. */
+    assert(parse("{\"contentId\": \"UP0000-PPSA99437_00-X\"}", id) == -1 && !id[0]);
+    /* Not an id: lower case, too short, too long, letters among the digits, not a string. */
+    assert(parse("{\"titleId\": \"ppsa11018\"}", id) == -1 && !id[0]);
+    assert(parse("{\"titleId\": \"PPSA1101\"}", id) == -1);
+    assert(parse("{\"titleId\": \"PPSA110180\"}", id) == -1);
+    assert(parse("{\"titleId\": \"PPSA1101X\"}", id) == -1);
+    assert(parse("{\"titleId\": 11018}", id) == -1);
+    /* A bad one first, a good one after it. */
+    assert(!parse("{\"titleId\": \"bad\", \"titleId\": \"PPSA99200\"}", id) && !strcmp(id, "PPSA99200"));
+    /* Cut short anywhere: never read past the end. */
+    {
+        static const char whole[] = "{\"titleId\": \"PPSA99437\"}";
+        /* The closing quote is the 23rd character: any shorter has no id. */
+        for (size_t n = 0; n <= sizeof(whole) - 1; n++) {
+            char *copy = malloc(n ? n : 1);
+            memcpy(copy, whole, n);
+            int r = pw_title_id_parse(copy, n, id);
+            assert(n >= 23 ? (r == 0 && !strcmp(id, "PPSA99437")) : (r == -1 && !id[0]));
+            free(copy);
+        }
+    }
+    assert(pw_title_id_parse(NULL, 0, id) == -1 && !id[0]);
+    assert(pw_title_id_parse("", 0, id) == -1 && !id[0]);
+}
+
+static void test_read(void)
+{
+    char dir[] = "/tmp/pw_title_id.XXXXXX", path[64], id[PW_TITLE_ID_SIZE];
+    FILE *file;
+
+    assert(mkdtemp(dir));
+    snprintf(path, sizeof(path), "%s/param.json", dir);
+    assert(pw_title_id_read(path, id) == -1 && !id[0]);   /* missing */
+    file = fopen(path, "w");
+    assert(file);
+    fputs("{\n  \"titleId\": \"PPSA99437\"\n}\n", file);
+    fclose(file);
+    assert(!pw_title_id_read(path, id) && !strcmp(id, "PPSA99437"));
+    /* Larger than any param.json: refused, not cut. */
+    file = fopen(path, "w");
+    assert(file);
+    for (int i = 0; i < PW_TITLE_ID_FILE_MAX / 16 + 1; i++) fputs("                ", file);
+    fputs("{\"titleId\": \"PPSA99437\"}", file);
+    fclose(file);
+    assert(pw_title_id_read(path, id) == -1 && !id[0]);
+    unlink(path);
+    rmdir(dir);
+    assert(pw_title_id_read(NULL, id) == -1 && !id[0]);
+}
+
+int main(void)
+{
+    test_parse();
+    test_read();
+    puts("title id tests passed");
+    return 0;
+}
