--- /dev/null
+++ b/native/pw_title_id.h
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_TITLE_ID_FILE_H
+#define PW_TITLE_ID_FILE_H
+/* The title id an app folder was registered with: the "titleId" of its
+ * sce_sys/param.json. One build of the title then serves copies of the app
+ * under other ids (PC5's home screen tiles).
+ *
+ * Header only, included by wine64_main.c and its host test: the eboot's
+ * source list in tools/build_native.sh stays as it is. */
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+/* Four capital letters, five digits and the terminating NUL. */
+#define PW_TITLE_ID_SIZE 10
+/* The largest param.json read; a real one is about 1 KiB. */
+#define PW_TITLE_ID_FILE_MAX 65536
+
+static inline int pw_title_id_valid(const char *s)
+{
+    for (int i = 0; i < 4; i++)
+        if (s[i] < 'A' || s[i] > 'Z') return 0;
+    for (int i = 4; i < 9; i++)
+        if (s[i] < '0' || s[i] > '9') return 0;
+    return 1;
+}
+
+static inline int pw_title_id_space(char c)
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
+
+/* The first "titleId": "<id>" in text that is a title id (PPSA12345). 0, or
+ * -1 with out empty when there is none. */
+static inline int pw_title_id_parse(const char *text, size_t length, char out[PW_TITLE_ID_SIZE])
+{
+    static const char key[] = "\"titleId\"";
+    const size_t key_length = sizeof(key) - 1;
+
+    out[0] = 0;
+    if (!text) return -1;
+    for (size_t at = 0; at + key_length <= length; at++) {
+        size_t i;
+        if (memcmp(text + at, key, key_length)) continue;
+        i = at + key_length;
+        while (i < length && pw_title_id_space(text[i])) i++;
+        if (i >= length || text[i] != ':') continue;
+        i++;
+        while (i < length && pw_title_id_space(text[i])) i++;
+        /* A quote, nine characters and a quote. */
+        if (i + 11 > length || text[i] != '"' || text[i + 10] != '"' || !pw_title_id_valid(text + i + 1)) continue;
+        memcpy(out, text + i + 1, PW_TITLE_ID_SIZE - 1);
+        out[PW_TITLE_ID_SIZE - 1] = 0;
+        return 0;
+    }
+    return -1;
+}
+
+/* The same from the file at path. 0, or -1 with out empty when the file
+ * can't be read, is larger than PW_TITLE_ID_FILE_MAX or holds no id. */
+static inline int pw_title_id_read(const char *path, char out[PW_TITLE_ID_SIZE])
+{
+    /* Static: the title reads this once, before its threads start. */
+    static char text[PW_TITLE_ID_FILE_MAX + 1];
+    size_t length = 0;
+    int fd;
+
+    out[0] = 0;
+    if (!path || (fd = open(path, O_RDONLY)) < 0) return -1;
+    for (;;) {
+        ssize_t got = read(fd, text + length, sizeof(text) - length);
+        if (got < 0) {
+            close(fd);
+            return -1;
+        }
+        if (got == 0) break;
+        length += (size_t)got;
+        if (length == sizeof(text)) {   /* larger than any param.json */
+            close(fd);
+            return -1;
+        }
+    }
+    close(fd);
+    return pw_title_id_parse(text, length, out);
+}
+
+#endif
