+/* The id this process runs as: the titleId of its own app0's param.json,
+ * read before /data is granted (find_title_id), or PW_TITLE_ID when that
+ * can't be read. A copy of the app under another id (a PC5 home screen tile)
+ * then finds its own sandbox, not the one of the id it was built with. */
+#define PW_TITLE_PARAM "/app0/sce_sys/param.json"
+static char title_id[PW_TITLE_ID_SIZE] = PW_TITLE_ID;
+static const char *title_id_from = "built-in";
 /* The console counts the sandbox instance up (_001, ...) when an earlier one
  * was left behind, so once /data is granted the one that holds the runtime
  * is looked for (find_sandbox_app0); _000 until then. */
 static char sandbox_app0[64] = PW_SANDBOX_APP0;
 static const char *const runtime_roots[] = { "/app0", sandbox_app0 };
+
+/* Before anything else: /app0 is not visible once /data is granted. */
+static void find_title_id(void)
+{
+    char id[PW_TITLE_ID_SIZE];
+
+    if (pw_title_id_read(PW_TITLE_PARAM, id) == 0) {
+        memcpy(title_id, id, sizeof(title_id));
+        title_id_from = "param.json";
+    }
+    snprintf(sandbox_app0, sizeof(sandbox_app0), "/mnt/sandbox/%s_000/app0", title_id);
+}
 /* The title's data: profiles/, input/, prefix/ and prefixes/<name>. */
 #ifndef PW_WINE64_ROOT_DATA
 #define PW_WINE64_ROOT_DATA "/data/prospero-win"            /* when /data is granted */
@@ -751,7 +771,7 @@ static void find_sandbox_app0(void)
