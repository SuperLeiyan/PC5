diff --git a/wine/patches/0936-ntdll-ps5-list-a-directory-by-its-nt-name.patch b/wine/patches/0936-ntdll-ps5-list-a-directory-by-its-nt-name.patch
new file mode 100644
index 0000000..71d0da9
--- /dev/null
+++ b/wine/patches/0936-ntdll-ps5-list-a-directory-by-its-nt-name.patch
@@ -0,0 +1,106 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Wed, 28 Oct 2026 18:30:00 +0000
+Subject: [PATCH] ntdll: List a directory by its NT name when the server keeps
+ no Unix name for it on PS5.
+
+Patch 0140 enters a directory a handle names by the Unix name the server
+keeps for it, as the descriptor came from the in-process server and
+fchdir() knows no path for it. When the server keeps none (its realpath
+failed, or a directory opened relative to another whose name it lacks),
+NtQueryDirectoryFile failed with STATUS_INVALID_HANDLE, fchdir()'s EBADF:
+.NET's FileSystemEnumerator threw "invalid handle" for a game's folder
+(Heroes of Might and Magic: Olden Era, StreamingAssets\maps\Story_maps),
+and the game's maps never loaded.
+
+The directory is now entered by the Unix name of the NT name the server
+keeps for every file it opens (\??\C:\...), as NtCreateFile resolves it.
+A directory still not entered is logged with which name failed and why.
+---
+diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
+--- a/dlls/ntdll/unix/file.c
++++ b/dlls/ntdll/unix/file.c
+@@ -2904,6 +2904,45 @@
+ }
+ 
+ 
++#ifdef __PROSPERO__
++/* The Unix name of a handle's file from its NT name (\??\C:\...), which the server
++ * keeps for every file it opens: for a handle it keeps no Unix name for. NULL when
++ * there is none. */
++static char *unix_name_from_nt_name( HANDLE handle )
++{
++    static const data_size_t size = 4096 * sizeof(WCHAR);
++    UNICODE_STRING name, nt_name = { 0 };
++    OBJECT_ATTRIBUTES attr;
++    char *unix_name = NULL;
++    unsigned int status;
++    WCHAR *buffer;
++
++    if (!(buffer = malloc( size + sizeof(WCHAR) ))) return NULL;
++    SERVER_START_REQ( get_object_name )
++    {
++        req->handle = wine_server_obj_handle( handle );
++        wine_server_set_reply( req, buffer, size );
++        status = wine_server_call( req );
++        name.Length = name.MaximumLength = status ? 0 : wine_server_reply_size( reply );
++    }
++    SERVER_END_REQ;
++    if (!status && name.Length)
++    {
++        buffer[name.Length / sizeof(WCHAR)] = 0;
++        name.Buffer = buffer;
++        InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
++        if (get_nt_and_unix_names( &attr, &nt_name, &unix_name, FILE_OPEN, FALSE ))
++        {
++            free( unix_name );
++            unix_name = NULL;
++        }
++        free( nt_name.Buffer );
++    }
++    free( buffer );
++    return unix_name;
++}
++#endif
++
+ /***********************************************************************
+  *           enter_directory
+  *
+@@ -2913,14 +2952,30 @@
+ {
+ #ifdef __PROSPERO__
+     char *unix_name;
+-    int ret;
++    unsigned int status;
++    int ret, fchdir_errno, chdir_errno;
+ 
+     if (fchdir( fd ) != -1) return 0;
++    fchdir_errno = errno;
+     /* The descriptor came from the in-process server, so this module's
+      * working-directory emulation knows no path for it: enter the directory
+-     * by the name the server opened it with. */
+-    if (server_get_unix_name( handle, &unix_name )) return -1;
+-    ret = chdir( unix_name );
++     * by the name the server opened it with, or, when the server keeps no
++     * Unix name for it, by its NT name. */
++    if ((status = server_get_unix_name( handle, &unix_name )) && !(unix_name = unix_name_from_nt_name( handle )))
++    {
++        ERR( "can't list directory handle %p: fd %d not entered (errno %d), no name for it (status %#x)\n",
++             handle, fd, fchdir_errno, status );
++        errno = fchdir_errno;
++        return -1;
++    }
++    if ((ret = chdir( unix_name )) == -1)
++    {
++        chdir_errno = errno;
++        ERR( "can't list directory %s: fd %d not entered (errno %d), nor its name (errno %d)\n",
++             debugstr_a( unix_name ), fd, fchdir_errno, chdir_errno );
++        errno = chdir_errno;
++    }
++    else if (status) WARN( "directory handle %p entered by its NT name, %s\n", handle, debugstr_a( unix_name ) );
+     free( unix_name );
+     return ret;
+ #else
+-- 
+2.43.0
+
