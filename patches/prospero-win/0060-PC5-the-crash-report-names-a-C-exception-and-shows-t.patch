diff --git a/wine/patches/0939-kernelbase-crash-report-names-a-c-exception-and-shows-the-code.patch b/wine/patches/0939-kernelbase-crash-report-names-a-c-exception-and-shows-the-code.patch
new file mode 100644
index 0000000..be8477e
--- /dev/null
+++ b/wine/patches/0939-kernelbase-crash-report-names-a-c-exception-and-shows-the-code.patch
@@ -0,0 +1,111 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 30 Oct 2026 09:00:00 +0000
+Subject: [PATCH] kernelbase: The crash report names a C++ exception and shows the code at the fault.
+
+A game's engine that stops itself with a C++ exception it doesn't catch
+(0xe06d7363) was reported only by its code and address: Call of Juarez
+Gunslinger's common.dll gave up the same way in every log, and none said
+why. The crash report now names the exception's type, as the compiler
+does (".?AVruntime_error@std@@"), and, for a std::exception, its
+message. A fault on an instruction the console refuses was reported as a
+read of FFFFFFFF with no way to tell which (Far Cry's CrySystem.dll):
+the report now has the flags register and the 16 bytes of code at the
+fault. Both are read under an exception handler, from the program's own
+data, and only add lines to a report that is made anyway.
+---
+diff --git a/dlls/kernelbase/debug.c b/dlls/kernelbase/debug.c
+--- a/dlls/kernelbase/debug.c
++++ b/dlls/kernelbase/debug.c
+@@ -558,6 +558,79 @@ static const WCHAR *code_module( ULONG_PTR addr, ULONG_PTR *base, USHORT *len )
+     return NULL;
+ }
+ 
++#if defined(__i386__) || defined(__x86_64__)
++/* The flags register and the 16 bytes of code at the fault: an instruction the console refuses
++ * (a privileged one, or one the kernel doesn't emulate) shows there, and the flags a program set
++ * (NT, which makes the kernel's return fault) with it. */
++static void crash_code( const CONTEXT *ctx, ULONG_PTR pc )
++{
++    unsigned char code[16];
++
++    __TRY
++    {
++        memcpy( code, (const void *)pc, sizeof(code) );
++        MESSAGE( "wine: crash report: flags=%08lx code at it: %02x %02x %02x %02x %02x %02x %02x %02x "
++                 "%02x %02x %02x %02x %02x %02x %02x %02x\n", (unsigned long)ctx->EFlags,
++                 code[0], code[1], code[2], code[3], code[4], code[5], code[6], code[7],
++                 code[8], code[9], code[10], code[11], code[12], code[13], code[14], code[15] );
++    }
++    __EXCEPT_PAGE_FAULT
++    {
++        MESSAGE( "wine: crash report: flags=%08lx, no code at it\n", (unsigned long)ctx->EFlags );
++    }
++    __ENDTRY
++}
++
++/* A C++ exception a program threw and didn't catch (0xe06d7363, as MSVC throws them): its type,
++ * as the compiler names it (".?AVruntime_error@std@@"), and the message of a std::exception,
++ * which says why a game's engine gave up. Read with care: a program's own data. */
++static void crash_cxx( const EXCEPTION_RECORD *rec )
++{
++    ULONG_PTR image = 0;
++    const char *name = NULL, *what = NULL;
++    BOOL is_std = FALSE;
++
++    if (rec->ExceptionCode != 0xe06d7363 || rec->NumberParameters < 3 ||
++        rec->ExceptionInformation[0] < 0x19930520 || rec->ExceptionInformation[0] > 0x19930522 ||
++        !rec->ExceptionInformation[2])
++        return;
++#ifdef _WIN64
++    if (rec->NumberParameters < 4) return;
++    image = rec->ExceptionInformation[3];   /* 64-bit: what follows are offsets from the module */
++#endif
++    __TRY
++    {
++        /* ThrowInfo: attributes, unwind, forward compatibility, the catchable types; each a
++         * 32-bit pointer, or an offset on 64-bit. */
++        const DWORD *throw_info = (const DWORD *)rec->ExceptionInformation[2];
++        const DWORD *types = (const DWORD *)(image + throw_info[3]);
++        unsigned int count = types[0], i;
++
++        for (i = 0; i < count && i < 16; i++)
++        {
++            /* CatchableType: properties, its type_info (a vtable, a pointer, then the name) */
++            const DWORD *catchable = (const DWORD *)(image + types[1 + i]);
++            const char *type_name = (const char *)(image + catchable[1]) + 2 * sizeof(void *);
++            if (!i) name = type_name;
++            if (!strcmp( type_name, ".?AVexception@std@@" )) is_std = TRUE;
++        }
++        if (name) MESSAGE( "wine: crash report: C++ exception %s\n", debugstr_an( name, 120 ) );
++        /* std::exception: its vtable, then its message */
++        if (is_std && rec->ExceptionInformation[1])
++            what = ((const char *const *)rec->ExceptionInformation[1])[1];
++        if (what) MESSAGE( "wine: crash report: its message: %s\n", debugstr_an( what, 200 ) );
++    }
++    __EXCEPT_PAGE_FAULT
++    {
++        MESSAGE( "wine: crash report: the C++ exception's type can't be read\n" );
++    }
++    __ENDTRY
++}
++#else
++static void crash_code( const CONTEXT *ctx, ULONG_PTR pc ) {}
++static void crash_cxx( const EXCEPTION_RECORD *rec ) {}
++#endif
++
+ static void crash_report( EXCEPTION_POINTERS *epointers )
+ {
+     const CONTEXT *ctx = epointers->ContextRecord;
+@@ -580,6 +653,8 @@ static void crash_report( EXCEPTION_POINTERS *epointers )
+ #endif
+     if ((name = code_module( pc, &base, &len )))
+         MESSAGE( "wine: crash report: at %s+0x%Ix\n", debugstr_wn( name, len ), pc - base );
++    crash_code( ctx, pc );
++    crash_cxx( epointers->ExceptionRecord );
+     slot = (ULONG_PTR *)sp;
+     top = NtCurrentTeb()->Tib.StackBase;
+     if (slot < (ULONG_PTR *)NtCurrentTeb()->Tib.StackLimit || slot >= top || (sp & (sizeof(ULONG_PTR) - 1)))
+-- 
+2.43.0
+
