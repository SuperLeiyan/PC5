+++ b/wine/patches/0941-ntdll-ps5-clear-the-nested-task-flag-a-program-set.patch
@@ -0,0 +1,43 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 30 Oct 2026 11:00:00 +0000
+Subject: [PATCH] ntdll: Clear the nested-task flag a program set when a return to it faults on PS5.
+
+Far Cry's CPU check (CrySystem.dll) sets the nested-task flag (NT,
+0x4000) with popf. An iretq with it set faults, so the next return to
+the program, from Wine's 64-bit side or the kernel's, raised a general
+protection fault that Wine reported as a read of FFFFFFFF, and the game
+crashed as it started (Wine bug 33275, which Linux fixed by clearing NT
+on entry, as Windows does). A general protection fault with NT set in
+the frame now clears it and runs the instruction again, logged the
+first time. No program uses NT, and no fault without it changes.
+---
+diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
+--- a/dlls/ntdll/unix/signal_x86_64.c
++++ b/dlls/ntdll/unix/signal_x86_64.c
+@@ -2948,6 +2948,22 @@ static void __attribute__((used)) segv_handler( int signal, siginfo_t *siginfo,
+     case TRAP_x86_PROTFLT:   /* General protection fault */
+         {
+             WORD err = ERROR_sig(sigcontext);
++#ifdef __PROSPERO__
++            /* The nested-task flag, which a program sets with popf (Far Cry's CPU check does,
++             * Wine bug 33275), makes the next iretq fault: the one that returns to its 32-bit
++             * code from Wine's 64-bit side, or the kernel's. Windows and Linux clear it on entry;
++             * here it is cleared in the frame and the instruction runs again. */
++            if (TRAP_sig(sigcontext) == TRAP_x86_PROTFLT && (EFL_sig(sigcontext) & 0x4000))
++            {
++                static LONG cleared;
++                if (InterlockedIncrement( &cleared ) == 1)
++                    MESSAGE( "wine-ps5: the nested-task flag a program set made a return to it fault at %p: "
++                             "cleared\n", (void *)RIP_sig(sigcontext) );
++                EFL_sig(sigcontext) &= ~0x4000;
++                leave_handler( data, sigcontext );
++                return;
++            }
++#endif
+             if (!err && (rec.ExceptionCode = is_privileged_instr( &context.c ))) break;
+             if ((err & 7) == 2 && handle_interrupt( data, sigcontext, &rec, &context )) return;
+             rec.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+-- 
+2.43.0
+
