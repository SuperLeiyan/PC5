diff --git a/wine/patches/0938-ntdll-ps5-log-which-step-refuses-a-directory-listing.patch b/wine/patches/0938-ntdll-ps5-log-which-step-refuses-a-directory-listing.patch
new file mode 100644
index 0000000..48ae19b
--- /dev/null
+++ b/wine/patches/0938-ntdll-ps5-log-which-step-refuses-a-directory-listing.patch
@@ -0,0 +1,74 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Thu, 29 Oct 2026 11:00:00 +0000
+Subject: [PATCH] ntdll: Log which step refuses a directory listing on PS5.
+
+NtQueryDirectoryFile can fail before patch 0936's logging is reached: the
+server gives no descriptor for the handle, the handle isn't a
+directory, or the directory's names aren't read (the directory cache
+refuses the handle). Each returned a status, often STATUS_INVALID_HANDLE,
+that a .NET game reports only as "invalid handle" for its folder (Heroes
+of Might and Magic: Olden Era, StreamingAssets\maps\Story_maps, still
+after 0936). Each of these now logs an error with the directory's name
+when the server keeps one, the step and the status. A listing that
+works, and one that only ends (no more files), logs nothing.
+---
+diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
+--- a/dlls/ntdll/unix/file.c
++++ b/dlls/ntdll/unix/file.c
+@@ -2987,6 +2987,20 @@ static int enter_directory( HANDLE handle, int fd )
+ /******************************************************************************
+  *              NtQueryDirectoryFile   (NTDLL.@)
+  */
++#ifdef __PROSPERO__
++/* A directory a program lists that can't be: logged as an error, with its name when the server
++ * keeps one, so a game's log says which step refused it (a .NET game's "invalid handle"). */
++static void ps5_dir_failed( HANDLE handle, const char *why, unsigned int status )
++{
++    char *unix_name = NULL;
++
++    if (server_get_unix_name( handle, &unix_name ) && !(unix_name = unix_name_from_nt_name( handle ))) unix_name = NULL;
++    ERR( "can't list directory %s (handle %p): %s (status %#x)\n", unix_name ? debugstr_a( unix_name ) : "?",
++         handle, why, status );
++    free( unix_name );
++}
++#endif
++
+ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc_routine,
+                                       void *apc_context, IO_STATUS_BLOCK *io, void *buffer, ULONG length,
+                                       FILE_INFORMATION_CLASS info_class, BOOLEAN single_entry,
+@@ -3034,11 +3048,19 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
+     if (!buffer) return STATUS_ACCESS_VIOLATION;
+ 
+     if ((status = server_get_unix_fd( handle, FILE_LIST_DIRECTORY, &fd, &needs_close, &type, NULL )))
++    {
++#ifdef __PROSPERO__
++        ps5_dir_failed( handle, "the server gives no descriptor for it", status );
++#endif
+         return status;
++    }
+ 
+     if (type != FD_TYPE_DIR)
+     {
+         if (needs_close) close( fd );
++#ifdef __PROSPERO__
++        ps5_dir_failed( handle, "it isn't a directory", STATUS_INVALID_PARAMETER );
++#endif
+         return STATUS_INVALID_PARAMETER;
+     }
+ 
+@@ -3065,6 +3087,11 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
+             else if (status == STATUS_MORE_ENTRIES) status = STATUS_SUCCESS;
+         }
+         if (cwd == -1 || fchdir( cwd ) == -1) chdir( "/" );
++#ifdef __PROSPERO__
++        if (status && status != STATUS_NO_MORE_FILES && status != STATUS_NO_SUCH_FILE &&
++            status != STATUS_BUFFER_OVERFLOW)
++            ps5_dir_failed( handle, "its names weren't read", status );
++#endif
+     }
+     else status = errno_to_status( errno );
+ 
+-- 
+2.43.0
