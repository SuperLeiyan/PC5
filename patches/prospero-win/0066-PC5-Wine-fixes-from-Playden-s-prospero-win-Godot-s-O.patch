 }
 
+/* A controller coming or going is counted and wakes the driver (Wine patch 0984);
+ * a new state of one already there, or a disconnect of one not there, is not. */
+static void test_pad_changes(void)
+{
+    PwWinePad pad={0};
+    char drain[64];
+    int fd=pw_wine_input_fd();
+    uint32_t before;
+
+    assert(fd!=-1);
+    pw_wine_set_dualsense(NULL);
+    while(read(fd,drain,sizeof(drain))>0){}
+    before=pw_wine_pad_changes();
+    pw_wine_set_pad_at(1,NULL);assert(pw_wine_pad_changes()==before && read(fd,drain,1)==-1);
+    pad.buttons=1;pw_wine_set_pad_at(1,&pad);
+    assert(pw_wine_pad_changes()==before+1 && read(fd,drain,sizeof(drain))==1);
+    pad.buttons=2;pw_wine_set_pad_at(1,&pad);assert(pw_wine_pad_changes()==before+1 && read(fd,drain,1)==-1);
+    pw_wine_set_pad_at(1,NULL);assert(pw_wine_pad_changes()==before+2 && read(fd,drain,sizeof(drain))==1);
+    PwDualSenseState state={0};
+    pw_wine_set_dualsense(&state);assert(pw_wine_pad_changes()==before+3 && read(fd,drain,sizeof(drain))==1);
+    pw_wine_set_dualsense(&state);assert(pw_wine_pad_changes()==before+3);
+    pw_wine_set_dualsense(NULL);assert(pw_wine_pad_changes()==before+4);
+    while(read(fd,drain,sizeof(drain))>0){}
+}
+
 static void test_dualsense(void)
 {
     PwDualSenseState state,got;
@@ -393,5 +418,6 @@ int main(void)
     test_dualsense();
     test_display_release();
     test_players();
+    test_pad_changes();
     return 0;
 }
