diff --git a/wine/patches/0956-gdi32-keep-a-window-s-pixel-format-with-a-native-opengl32.patch b/wine/patches/0956-gdi32-keep-a-window-s-pixel-format-with-a-native-opengl32.patch
new file mode 100644
index 0000000..0f7cfcb
--- /dev/null
+++ b/wine/patches/0956-gdi32-keep-a-window-s-pixel-format-with-a-native-opengl32.patch
@@ -0,0 +1,32 @@
+From: Prospero Win <prospero-win@invalid>
+Subject: [PATCH] gdi32: keep a window's pixel format with a native opengl32
+
+On Windows a window keeps the pixel format it was given first: setting
+the same format again succeeds and another one fails. Wine's builtin
+opengl32 (win32u) does this itself, but gdi32 hands SetPixelFormat to
+whichever opengl32 is loaded, and Mesa's WGL, loaded natively for the
+PS5's Zink path, refuses every second call on a window. Godot 4 sets the
+format of its main window twice, once in window_create and again in
+_create_context, so its OpenGL renderer stopped at "Failed to create an
+OpenGL window". gdi32 now answers a repeated call from the window's
+current format before reaching the driver.
+---
+diff --git a/dlls/gdi32/opengl.c b/dlls/gdi32/opengl.c
+index 0fbd851..2094da1 100644
+--- a/dlls/gdi32/opengl.c
++++ b/dlls/gdi32/opengl.c
+@@ -92,6 +92,14 @@ BOOL WINAPI SetPixelFormat( HDC hdc, INT fmt, const PIXELFORMATDESCRIPTOR *pfd )
+         if (!(wglSetPixelFormat = (void *)GetProcAddress( opengl32, "wglSetPixelFormat" )))
+             return FALSE;
+     }
++    /* As on Windows, a window that already has a pixel format keeps it:
++     * setting the same one again succeeds, another one fails. Wine's own
++     * opengl32 does this itself, but a native one such as Mesa's WGL
++     * refuses any second call, which Godot 4 makes on its main window. */
++    {
++        INT current = GetPixelFormat( hdc );
++        if (current) return current == fmt;
++    }
+     return wglSetPixelFormat( hdc, fmt, pfd );
+ }
+ 
diff --git a/wine/patches/0958-ntdll-honor-wine-cpu-topology-s-processor-count.patch b/wine/patches/0958-ntdll-honor-wine-cpu-topology-s-processor-count.patch
new file mode 100644
index 0000000..65e856a
--- /dev/null
+++ b/wine/patches/0958-ntdll-honor-wine-cpu-topology-s-processor-count.patch
@@ -0,0 +1,58 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sun, 11 Oct 2026 22:00:00 +0200
+Subject: [PATCH] ntdll: Honor WINE_CPU_TOPOLOGY's processor count.
+
+Proton reads WINE_CPU_TOPOLOGY ("<count>:<cpu>,<cpu>,...") to tell a game
+it has fewer processors, which some games need to start or run well;
+upstream Wine does not read it. Take its count when it is between 1 and
+the processors the process has (patch 0881), and report it as
+NumberOfProcessors. The CPU list is not used: the console gives a title
+no affinity control. Say what was taken, or why it was ignored, on
+stderr, which the title keeps in the session log.
+---
+ dlls/ntdll/unix/system.c | 21 +++++++++++++++++++++
+ 1 file changed, 21 insertions(+)
+
+diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
+index a8b5939..253cff5 100644
+--- a/dlls/ntdll/unix/system.c
++++ b/dlls/ntdll/unix/system.c
+@@ -1786,6 +1786,26 @@ static long ps5_process_cpus( long online )
+ }
+ #endif
+ 
++/* WINE_CPU_TOPOLOGY, in Proton's form "<count>:<cpu>,<cpu>,...": a game that
++ * fails or runs worse with many processors is told it has <count>. Only the
++ * count is used, and it can only lower the number; anything else is ignored. */
++static long cpu_topology_override( long num )
++{
++    const char *env = getenv( "WINE_CPU_TOPOLOGY" );
++    char *end;
++    long count;
++
++    if (!env || !*env) return num;
++    count = strtol( env, &end, 10 );
++    if (end == env || (*end && *end != ':') || count < 1 || count > num)
++    {
++        MESSAGE( "wine: WINE_CPU_TOPOLOGY=%s ignored, %ld processors\n", env, num );
++        return num;
++    }
++    MESSAGE( "wine: WINE_CPU_TOPOLOGY=%s, %ld of %ld processors\n", env, count, num );
++    return count;
++}
++
+ void init_cpu_info(void)
+ {
+     long num;
+@@ -1814,6 +1834,7 @@ void init_cpu_info(void)
+     num = 1;
+     FIXME("Detecting the number of processors is not supported.\n");
+ #endif
++    num = cpu_topology_override( num );
+     peb->NumberOfProcessors = num;
+     init_cpu_model();
+     get_random( &process_cookie, sizeof(process_cookie) );
+-- 
+2.43.0
+
