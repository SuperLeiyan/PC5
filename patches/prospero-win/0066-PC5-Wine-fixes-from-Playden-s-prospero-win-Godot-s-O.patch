diff --git a/wine/patches/0971-kernelbase-ps5-no-debugger-in-a-title.patch b/wine/patches/0971-kernelbase-ps5-no-debugger-in-a-title.patch
new file mode 100644
index 0000000..ce2d9ec
--- /dev/null
+++ b/wine/patches/0971-kernelbase-ps5-no-debugger-in-a-title.patch
@@ -0,0 +1,89 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 16 Oct 2026 08:50:41 +0200
+Subject: [PATCH] kernelbase: Do not start a debugger in a PS5 title.
+
+A PS5 title is one process and ntdll fails process creation there (patch
+0550), so winedbg never starts. Before CreateProcessW fails,
+start_debugger reads AeDebug and allocates the command line and a copy
+of the environment from the process heap. When the faulting game holds
+that lock in another thread, the crash froze the title instead of ending
+it: Call of Juarez Gunslinger waited on its main heap lock forever. Other
+threads that fault meanwhile wait for the first one on the debugger
+event.
+
+In a title (the starter sets WINE_PS5_NTDLL_DIR, read once at DLL
+attach), UnhandledExceptionFilter still calls the game's own filter, then
+logs the exception and lets the thread's handler terminate the process
+(patch 0896 then leaves through exit()).
+---
+ dlls/kernelbase/debug.c      | 23 +++++++++++++++++++++++
+ dlls/kernelbase/kernelbase.h |  1 +
+ dlls/kernelbase/main.c       |  1 +
+ 3 files changed, 25 insertions(+)
+
+diff --git a/dlls/kernelbase/debug.c b/dlls/kernelbase/debug.c
+index 8dbb677..a054e0d 100644
+--- a/dlls/kernelbase/debug.c
++++ b/dlls/kernelbase/debug.c
+@@ -670,6 +670,19 @@ exit:
+     return ret;
+ }
+ 
++/* A PS5 title is a single process (ntdll fails process creation there), so
++ * winedbg never starts. start_debugger's registry and heap work then only
++ * waits on locks the crashed game may hold: Call of Juarez Gunslinger froze
++ * on the process heap lock instead of ending. The title's Wine starter sets
++ * WINE_PS5_NTDLL_DIR; it is read at start, not on the crash path. */
++static BOOL no_debugger;
++
++void init_debugger(void)
++{
++    no_debugger = GetEnvironmentVariableW( L"WINE_PS5_NTDLL_DIR", NULL, 0 ) > 0;
++}
++
++
+ /******************************************************************
+  *		start_debugger_atomic
+  *
+@@ -782,6 +795,16 @@ LONG WINAPI UnhandledExceptionFilter( EXCEPTION_POINTERS *epointers )
+             if (ret != EXCEPTION_CONTINUE_SEARCH) return ret;
+         }
+ 
++        if (no_debugger)
++        {
++            char buffer[256];
++
++            format_exception_msg( epointers, buffer, sizeof(buffer) );
++            MESSAGE( "wine: %s (thread %04lx), no debugger, ending the process\n",
++                     buffer, GetCurrentThreadId() );
++            return nested ? EXCEPTION_CONTINUE_SEARCH : EXCEPTION_EXECUTE_HANDLER;
++        }
++
+         if ((GetErrorMode() & SEM_NOGPFAULTERRORBOX) ||
+             !start_debugger_atomic( epointers ) || !NtCurrentTeb()->Peb->BeingDebugged)
+             return nested ? EXCEPTION_CONTINUE_SEARCH : EXCEPTION_EXECUTE_HANDLER;
+diff --git a/dlls/kernelbase/kernelbase.h b/dlls/kernelbase/kernelbase.h
+index e46ca0f..1b08f14 100644
+--- a/dlls/kernelbase/kernelbase.h
++++ b/dlls/kernelbase/kernelbase.h
+@@ -37,6 +37,7 @@ extern void init_global_data(void);
+ extern void init_startup_info( RTL_USER_PROCESS_PARAMETERS *params );
+ extern void init_locale( HMODULE module );
+ extern void init_console(void);
++extern void init_debugger(void);
+ extern BOOL is_console_handle( HANDLE );
+ 
+ extern const WCHAR windows_dir[];
+diff --git a/dlls/kernelbase/main.c b/dlls/kernelbase/main.c
+index 8c37e5d..9598c4c 100644
+--- a/dlls/kernelbase/main.c
++++ b/dlls/kernelbase/main.c
+@@ -49,6 +49,7 @@ BOOL WINAPI DllMain( HINSTANCE hinst, DWORD reason, LPVOID reserved )
+         init_locale( hinst );
+         init_startup_info( NtCurrentTeb()->Peb->ProcessParameters );
+         init_console();
++        init_debugger();
+     }
+     return TRUE;
+ }
diff --git a/wine/patches/0981-win32u-register-builtin-classes-without-waiting.patch b/wine/patches/0981-win32u-register-builtin-classes-without-waiting.patch
new file mode 100644
index 0000000..ed7846b
--- /dev/null
+++ b/wine/patches/0981-win32u-register-builtin-classes-without-waiting.patch
@@ -0,0 +1,151 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 16 Oct 2026 09:10:25 +0200
+Subject: [PATCH] win32u: Register the builtin classes without waiting on
+ another thread.
+
+register_builtin_classes() ran its body in a pthread_once, and the body
+takes the loader lock: it loads the classes' cursors through a callback
+into user32, and user32's part loads uxtheme.dll. A thread that held the
+loader lock (in a DllMain) and created its first window waited in the
+once for a thread that held the once and waited for the loader lock.
+
+On the PS5 this hangs Source games at startup: vgui2.dll's static
+initializer calls OleInitialize under the loader lock, while the hosted
+PnP thread creates its COM apartment window during device install.
+
+Now no thread waits: each one registers the classes still missing (one
+that another thread registered first is looked up), and the first one
+runs user32's part.
+---
+ dlls/win32u/class.c | 74 ++++++++++++++++++++++++++++++++-------------
+ 1 file changed, 53 insertions(+), 21 deletions(-)
+
+diff --git a/dlls/win32u/class.c b/dlls/win32u/class.c
+index 3ebef66..b5bcebe 100644
+--- a/dlls/win32u/class.c
++++ b/dlls/win32u/class.c
+@@ -59,7 +59,7 @@ struct builtin_class_descr
+     INT        extra;     /* window extra bytes */
+     ULONG_PTR  cursor;    /* cursor id */
+     HBRUSH     brush;     /* brush or system color */
+-    ATOM       atom;      /* class atom */
++    LONG       atom;      /* class atom, set by whichever thread registers it */
+ };
+ 
+ static struct builtin_class_descr builtin_classes[] =
+@@ -875,7 +875,7 @@ INT WINAPI NtUserGetClassName( HWND hwnd, BOOL real, UNICODE_STRING *name )
+     if (real && (fnid = get_window_fnid( hwnd )) && (fnid & 0x7fff) < ARRAY_SIZE(builtin_classes))
+     {
+         get_desktop_window(); /* create the desktop window to trigger builtin class registration */
+-        atom = builtin_classes[fnid & 0x7fff].atom;
++        atom = ReadAcquire( &builtin_classes[fnid & 0x7fff].atom );
+         return NtUserGetAtomName( atom, name );
+     }
+ 
+@@ -1057,7 +1057,27 @@ WORD get_class_word( HWND hwnd, INT offset )
+ ATOM get_builtin_class_atom( enum ntuser_client_procs proc )
+ {
+     get_desktop_window(); /* create the desktop window to trigger builtin class registration */
+-    return builtin_classes[proc].atom;
++    return ReadAcquire( &builtin_classes[proc].atom );
++}
++
++/***********************************************************************
++ *           find_class_atom
++ *
++ * The atom of a registered class, without registering the builtin classes.
++ */
++static ATOM find_class_atom( HINSTANCE instance, UNICODE_STRING *name )
++{
++    struct object_lock lock = OBJECT_LOCK_INIT;
++    const class_shm_t *class_shm;
++    NTSTATUS status;
++    CLASS *class;
++    ATOM atom = 0;
++
++    if (!(class = find_class( instance, name ))) return 0;
++    while ((status = get_shared_class( class, &lock, &class_shm )) == STATUS_PENDING)
++        atom = class_shm->info.atom;
++    release_class_ptr( class );
++    return status ? 0 : atom;
+ }
+ 
+ /***********************************************************************
+@@ -1071,6 +1091,7 @@ static void register_builtin( enum ntuser_client_procs proc )
+     struct builtin_class_descr *descr = builtin_classes + proc;
+     UNICODE_STRING name, version = { .Length = 0 };
+     WCHAR nameW[64];
++    ATOM atom;
+     WNDCLASSEXW class =
+     {
+         .cbSize = sizeof(class),
+@@ -1081,7 +1102,10 @@ static void register_builtin( enum ntuser_client_procs proc )
+         .lpfnWndProc = MAKE_WNDPROC( proc ),
+     };
+ 
+-    if (descr->atom) return; /* already registered */
++    if (ReadAcquire( &descr->atom )) return; /* already registered */
++    /* 64-bit Windows use sizeof(UINT64) for all processes, while 32-bit Windows use 6 for extra
++     * bytes size. Civilization II depends on the size being 6, so we use that even in wow64. */
++    if (proc == NTUSER_WNDPROC_EDIT && (sizeof(void *) == 4 || NtCurrentTeb()->WowTebOffset)) class.cbWndExtra = 6;
+     if (descr->cursor)
+         class.hCursor = LoadImageW( 0, (const WCHAR *)descr->cursor, IMAGE_CURSOR,
+                                     0, 0, LR_SHARED | LR_DEFAULTSIZE );
+@@ -1089,31 +1113,39 @@ static void register_builtin( enum ntuser_client_procs proc )
+     asciiz_to_unicode( nameW, descr->name );
+     RtlInitUnicodeString( &name, nameW );
+ 
+-    if ((descr->atom = NtUserRegisterClassExWOW( &class, &name, &version, NULL, MAKE_FNID(proc), 0, NULL ))) return;
++    if ((atom = NtUserRegisterClassExWOW( &class, &name, &version, NULL, MAKE_FNID(proc), 0, NULL )))
++    {
++        WriteRelease( &descr->atom, atom );
++        return;
++    }
+     if (class.hCursor) NtUserDestroyCursor( class.hCursor, 0 );
+-}
+-
+-static void register_builtins(void)
+-{
+-    struct builtin_class_descr *edit_class = builtin_classes + NTUSER_WNDPROC_EDIT;
+-    ULONG ret_len, i;
+-    void *ret_ptr;
+-
+-    /* 64-bit Windows use sizeof(UINT64) for all processes, while 32-bit Windows use 6 for extra
+-     * bytes size. Civilization II depends on the size being 6, so we use that even in wow64. */
+-    if (sizeof(void *) == 4 || NtCurrentTeb()->WowTebOffset) edit_class->extra = 6;
+-
+-    for (i = 0; i < ARRAY_SIZE(builtin_classes); i++) if (builtin_classes[i].name) register_builtin( i );
+-    KeUserModeCallback( NtUserInitBuiltinClasses, NULL, 0, &ret_ptr, &ret_len );
++    /* another thread registered it after the check above */
++    if ((atom = find_class_atom( user32_module, &name ))) WriteRelease( &descr->atom, atom );
+ }
+ 
+ /***********************************************************************
+  *           register_builtin_classes
++ *
++ * Loading the classes' cursors and user32's part (it loads uxtheme.dll)
++ * take the loader lock, so no thread waits here for another one: a thread
++ * that held the loader lock (in a DllMain) while another one held a once
++ * here and waited for the loader lock would never return. Each thread
++ * registers the classes still missing, and the first one runs user32's part.
+  */
+ void register_builtin_classes(void)
+ {
+-    static pthread_once_t init_once = PTHREAD_ONCE_INIT;
+-    pthread_once( &init_once, register_builtins );
++    static LONG registered, user32_init;
++    ULONG ret_len, i, error;
++    void *ret_ptr;
++
++    if (ReadAcquire( &registered )) return;
++    error = RtlGetLastWin32Error();  /* a class another thread registered first fails here */
++
++    for (i = 0; i < ARRAY_SIZE(builtin_classes); i++) if (builtin_classes[i].name) register_builtin( i );
++    WriteRelease( &registered, 1 );
++    RtlSetLastWin32Error( error );
++    if (!InterlockedExchange( &user32_init, 1 ))
++        KeUserModeCallback( NtUserInitBuiltinClasses, NULL, 0, &ret_ptr, &ret_len );
+ }
+ 
+ /***********************************************************************
diff --git a/wine/patches/0984-win32u-ps5-tell-windows-when-the-controller-comes-or-goes.patch b/wine/patches/0984-win32u-ps5-tell-windows-when-the-controller-comes-or-goes.patch
new file mode 100644
index 0000000..55f71bb
--- /dev/null
+++ b/wine/patches/0984-win32u-ps5-tell-windows-when-the-controller-comes-or-goes.patch
@@ -0,0 +1,80 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 16 Oct 2026 12:00:00 +0000
+Subject: [PATCH] win32u: Tell windows when a PS5 title's controller comes or goes.
+
+A PS5 title cannot run the plug and play service (patch 0550), which
+tells every top-level window that devices changed (WM_DEVICECHANGE with
+DBT_DEVNODES_CHANGED) when one is added or removed. Some games only look
+for a lost XInput controller again when told: an Unreal Engine 4 game
+whose controller went off kept it lost after it came back.
+
+The title counts each time a controller connects or disconnects
+(pw_wine_pad_changes) and wakes the driver's input fd. ProcessEvents
+then posts WM_DEVICECHANGE with DBT_DEVNODES_CHANGED to the top-level
+windows, once for any number of changes since it last looked. Without
+the title's call, as anywhere but in a title, nothing changes.
+
+From Playden's prospero-win (its patch 0984), placed in this series'
+driver.
+---
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+index a5ddb4f..602b922 100644
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -52,6 +52,7 @@
+ #include "ntstatus.h"
+ #include "ntgdi_private.h"
+ #include "ntuser_private.h"
++#include "dbt.h"
+ #include "wine/server.h"
+ #include "wine/debug.h"
+ #ifdef SONAME_LIBVULKAN
+@@ -84,6 +85,7 @@ struct ps5_window
+ static int (*present_frame)( const void *bgra, UINT width, UINT height, UINT stride );
+ static int (*next_input)( struct ps5_input *input );
+ static int (*input_fd)(void);
++static UINT32 (*pad_changes)(void);
+ 
+ static pthread_mutex_t screen_lock = PTHREAD_MUTEX_INITIALIZER;
+ static UINT screen_width = 800, screen_height = 600;
+@@ -609,6 +611,23 @@ static BOOL dialog_key( HWND hwnd, const struct ps5_input *event )
+     return send;
+ }
+ 
++/* The title's controller connected or disconnected since the last look
++ * (pw_wine_pad_changes). Windows then tells every top-level window that
++ * devices changed, through the plug and play service a title cannot run.
++ * Some games (Unreal Engine 4) only look for a lost XInput controller
++ * again when told. */
++static void notify_pad_changes(void)
++{
++    static UINT32 seen;
++    UINT32 changes;
++
++    if (!pad_changes) return;
++    changes = pad_changes();
++    if (__atomic_exchange_n( &seen, changes, __ATOMIC_RELAXED ) == changes) return;
++    TRACE( "controller connected or disconnected (%u): WM_DEVICECHANGE\n", changes );
++    NtUserPostMessage( HWND_BROADCAST, WM_DEVICECHANGE, DBT_DEVNODES_CHANGED, 0 );
++}
++
+ static BOOL ps5_ProcessEvents( DWORD mask )
+ {
+     static const DWORD button_flags[3][2] =
+@@ -688,6 +707,7 @@ static BOOL ps5_ProcessEvents( DWORD mask )
+             break;
+         }
+     }
++    notify_pad_changes();
+     /* The wake pipe is every GUI thread's queue fd, so a byte sets QS_DRIVER
+      * on all their queues while one of them drains it and takes the events;
+      * a byte can also come after its event was taken here. Either way this
+@@ -1021,6 +1041,7 @@ void ps5_install_user_driver(void)
+     present_frame = dlsym( RTLD_DEFAULT, "pw_wine_present" );
+     next_input = dlsym( RTLD_DEFAULT, "pw_wine_next_input" );
+     input_fd = dlsym( RTLD_DEFAULT, "pw_wine_input_fd" );
++    pad_changes = dlsym( RTLD_DEFAULT, "pw_wine_pad_changes" );
+ #ifdef SONAME_LIBVULKAN
+     release_display = dlsym( RTLD_DEFAULT, "pw_wine_release_display" );
+ #endif
diff --git a/wine/ps5/pw_wine_sink.c b/wine/ps5/pw_wine_sink.c
index ae7a283..923b056 100644
--- a/wine/ps5/pw_wine_sink.c
+++ b/wine/ps5/pw_wine_sink.c
@@ -28,6 +28,8 @@ static pthread_mutex_t dualsense_lock=PTHREAD_MUTEX_INITIALIZER;
 static PwDualSenseState dualsense_state;
 static PwDualSenseOutput dualsense_out;
 static uint32_t dualsense_out_seen;
+/* How many times a controller connected or disconnected (pw_wine_pad_changes). */
+static uint32_t pad_changes;
 /* Audio has its own lock: its sink blocks for a grain, which must not hold
  * up frames or input. */
 static pthread_mutex_t audio_lock=PTHREAD_MUTEX_INITIALIZER;
@@ -185,11 +187,22 @@ static int same_pad(const PwWinePad *a,const PwWinePad *b)
            a->right_trigger==b->right_trigger && a->thumb_lx==b->thumb_lx &&
            a->thumb_ly==b->thumb_ly && a->thumb_rx==b->thumb_rx && a->thumb_ry==b->thumb_ry;
 }
+/* A controller came or went: counted, and the driver woken to tell the game's
+ * windows (Wine patch 0984). A full pipe is already readable: nothing is lost. */
+static void pad_changed(void)
+{
+    char byte=1;
+    __atomic_add_fetch(&pad_changes,1,__ATOMIC_RELAXED);
+    pthread_once(&wake_once,create_wake_pipe);
+    if(wake[1]!=-1 && write(wake[1],&byte,1)<0){}
+}
+uint32_t pw_wine_pad_changes(void){return __atomic_load_n(&pad_changes,__ATOMIC_RELAXED);}
 void pw_wine_set_pad_at(uint32_t index,const PwWinePad *pad)
 {
     if(index>=PW_WINE_PADS)return;
     pthread_mutex_lock(&lock);
     PwWinePad *pad_state=&players[index].state;
+    int changed=(pad!=NULL)!=(pad_state->connected!=0);
     if(!pad)pad_state->connected=0;
     else if(!pad_state->connected || !same_pad(pad,pad_state)) {
         uint32_t packet=pad_state->packet+1;
@@ -197,6 +210,7 @@ void pw_wine_set_pad_at(uint32_t index,const PwWinePad *pad)
         pad_state->packet=packet?packet:1;   /* 0 is never a packet */
     }
     pthread_mutex_unlock(&lock);
+    if(changed)pad_changed();
 }
 void pw_wine_set_pad(const PwWinePad *pad){pw_wine_set_pad_at(0,pad);}
 int pw_wine_pad_at(uint32_t index,PwWinePad *pad)
@@ -236,6 +250,7 @@ static int same_dualsense(const PwDualSenseState *a,const PwDualSenseState *b)
 void pw_wine_set_dualsense(const PwDualSenseState *state)
 {
     pthread_mutex_lock(&dualsense_lock);
+    int changed=(state!=NULL)!=(dualsense_state.connected!=0);
     if(!state)dualsense_state.connected=0;
     else {
         uint32_t packet=dualsense_state.packet;
@@ -244,6 +259,7 @@ void pw_wine_set_dualsense(const PwDualSenseState *state)
         dualsense_state=*state;dualsense_state.connected=1;dualsense_state.packet=packet;
     }
     pthread_mutex_unlock(&dualsense_lock);
+    if(changed)pad_changed();
 }
 int pw_wine_dualsense(PwDualSenseState *state)
 {
diff --git a/wine/ps5/pw_wine_sink.h b/wine/ps5/pw_wine_sink.h
index c02f491..3250eae 100644
--- a/wine/ps5/pw_wine_sink.h
+++ b/wine/ps5/pw_wine_sink.h
@@ -116,6 +116,11 @@ int pw_wine_input_fd(void);
 int pw_wine_pad(PwWinePad *pad);
 /* The rumble a game asked for (XInputSetState); speeds are clamped. */
 void pw_wine_set_rumble(uint32_t left,uint32_t right);
+/* How many times a controller (a player's, or the DualSense) connected or
+ * disconnected. Each time also wakes the input fd, so the driver tells the
+ * game's windows that a device came or went (WM_DEVICECHANGE), as Windows
+ * does (Wine patch 0984). */
+uint32_t pw_wine_pad_changes(void);
 /* The same for player index; out of range, no controller is connected
  * there and its rumble is dropped. */
 int pw_wine_pad_at(uint32_t index,PwWinePad *pad);
