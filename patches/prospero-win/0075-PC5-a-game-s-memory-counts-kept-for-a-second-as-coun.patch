+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sat, 31 Oct 2026 09:30:00 +0000
+Subject: [PATCH] ntdll: PS5: keep the process memory counts for a second.
+
+Patch 0898 counts a process's memory (GetProcessMemoryInfo,
+ProcessVmCounters) by walking every view's pages with virtual_mutex
+held, which every allocation, protection change and page fault waits
+for. An Unreal Engine 5 game asks for its memory stats from several
+threads, about every 10 ms each, and with tens of GiB of views a walk
+took about as long: the queries followed one another without a break,
+the mutex was always held, and the game ran on about one core at 0 to
+1 frames a second (Gears of War: E-Day took 25 minutes to its splash
+screens and never finished compiling its shaders).
+
+The counts are now kept for a second: a query within a second of the
+last walk gets that walk's counts, with the mutex held only to copy
+them. The peaks are kept as before.
+---
+diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
+index 0e5237b..c7eb2be 100644
+--- a/dlls/ntdll/unix/virtual.c
++++ b/dlls/ntdll/unix/virtual.c
+@@ -1746,14 +1746,35 @@ static void VIRTUAL_Dump(void)
+  */
+ void virtual_fill_vm_counters( VM_COUNTERS_EX *pvmi )
+ {
++    /* Counting walks every view's pages with virtual_mutex held, which every allocation,
++     * protection change and page fault waits for. Unreal Engine games ask about 80 times a
++     * second (its memory stats), and with tens of GiB of views the walk took most of that
++     * time: the game ran on about one core at 0-1 fps. The counts are kept for a second. */
+     static SIZE_T peak_virtual, peak_working_set, peak_pagefile;
++    static SIZE_T kept_virtual, kept_working_set, kept_pagefile;
++    static ULONGLONG kept_at;
+     SIZE_T virtual_size = 0, working_set = 0, pagefile = 0, size, committed;
+     struct file_view *view;
++    struct timespec now;
++    ULONGLONG now_ms;
+     sigset_t sigset;
+     char *base;
+     BYTE vprot;
+ 
++    clock_gettime( CLOCK_MONOTONIC, &now );
++    now_ms = (ULONGLONG)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+     server_enter_uninterrupted_section( &virtual_mutex, &sigset );
++    if (kept_at && now_ms - kept_at < 1000)
++    {
++        pvmi->VirtualSize = kept_virtual;
++        pvmi->PeakVirtualSize = peak_virtual;
++        pvmi->WorkingSetSize = kept_working_set;
++        pvmi->PeakWorkingSetSize = peak_working_set;
++        pvmi->PagefileUsage = kept_pagefile;
++        pvmi->PeakPagefileUsage = peak_pagefile;
++        server_leave_uninterrupted_section( &virtual_mutex, &sigset );
++        return;
++    }
+     WINE_RB_FOR_EACH_ENTRY( view, &views_tree, struct file_view, entry )
+     {
+         committed = 0;
+@@ -1769,6 +1790,10 @@ void virtual_fill_vm_counters( VM_COUNTERS_EX *pvmi )
+     if (virtual_size > peak_virtual) peak_virtual = virtual_size;
+     if (working_set > peak_working_set) peak_working_set = working_set;
+     if (pagefile > peak_pagefile) peak_pagefile = pagefile;
++    kept_virtual = virtual_size;
++    kept_working_set = working_set;
++    kept_pagefile = pagefile;
++    kept_at = now_ms ? now_ms : 1;
+     pvmi->VirtualSize = virtual_size;
+     pvmi->PeakVirtualSize = peak_virtual;
+     pvmi->WorkingSetSize = working_set;
