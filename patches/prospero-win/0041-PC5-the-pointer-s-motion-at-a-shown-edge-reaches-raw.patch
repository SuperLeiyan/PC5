@@ -0,0 +1,70 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Tue, 27 Oct 2026 13:00:00 +0000
+Subject: [PATCH] win32u: Report the PS5 pointer's motion at a shown edge as raw
+ input.
+
+Where a frame shows less than the screen (one window, or a display mode
+smaller than the desktop), the driver stops the pointer at what is shown
+and sent no motion at all past that edge. A game that moves a pointer of
+its own by the mouse's motion (DirectInput, which reads WM_INPUT) then
+stopped short of its far side once the system's pointer reached the
+shown edge first: Sacred Underworld at 1024x768, its pointer a little
+before the right edge.
+
+The pointer still stops at the shown edge, but each motion goes to the
+server whole as raw input (SEND_HWMSG_RAWINPUT), as a mouse held against
+the screen's edge keeps reporting its motion on Windows.
+---
+ dlls/win32u/ps5drv.c | 22 +++++++++++++++++++++-
+ 1 file changed, 21 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -467,6 +467,22 @@
+     NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+ }
+ 
++/* Pointer motion: dx, dy move the pointer, raw_dx, raw_dy are what raw input
++ * (WM_INPUT, which DirectInput reads) reports, as a mouse held against the
++ * screen's edge still reports its motion while its pointer stays. */
++static void send_motion( HWND hwnd, INT dx, INT dy, INT raw_dx, INT raw_dy )
++{
++    INPUT input = {.type = INPUT_MOUSE};
++    struct raw_mouse raw = {.count = 1};
++
++    input.mi.dx = dx;
++    input.mi.dy = dy;
++    input.mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_MOVE_NOCOALESCE;
++    raw.data[0].x = raw_dx;
++    raw.data[0].y = raw_dy;
++    NtUserSendHardwareInput( hwnd, SEND_HWMSG_RAWINPUT, &input, (LPARAM)&raw );
++}
++
+ /* The pointer's position as the server keeps it, in screen coordinates. */
+ static BOOL server_cursor_pos( POINT *pos )
+ {
+@@ -501,6 +517,7 @@
+ static void move_cursor( HWND hwnd, INT dx, INT dy )
+ {
+     static BOOL placed;
++    INT raw_dx = dx, raw_dy = dy;
+     RECT shown;
+     POINT pos;
+ 
+@@ -518,7 +535,10 @@
+     if (!server_cursor_pos( &pos )) return;
+     dx = shown_motion( pos.x, dx, shown.left, shown.right, screen_width );
+     dy = shown_motion( pos.y, dy, shown.top, shown.bottom, screen_height );
+-    if (dx || dy) send_mouse( hwnd, MOUSEEVENTF_MOVE | MOUSEEVENTF_MOVE_NOCOALESCE, dx, dy );
++    /* At a shown edge the pointer stops but its motion still reaches raw input:
++     * a game that moves a pointer of its own by that motion, in a display mode
++     * smaller than the screen, reaches its far side (Sacred Underworld in 4:3). */
++    if (raw_dx || raw_dy) send_motion( hwnd, dx, dy, raw_dx, raw_dy );
+     if (!server_cursor_pos( &pos )) return;
+     pthread_mutex_lock( &screen_lock );
+     if (cursor.x != pos.x || cursor.y != pos.y)
