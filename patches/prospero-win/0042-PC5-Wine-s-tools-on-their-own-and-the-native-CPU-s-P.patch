From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bornaradusin <bornaradusin@users.noreply.github.com>
Date: Tue, 27 Oct 2026 14:00:00 +0000
Subject: [PATCH] PC5: Wine's tools on their own, and the native CPU's PS5
 module apart from its Windows one

build_host_wine.sh --tools-only builds Wine's own tools alone (make
__tooldeps__), which build_wine_ps5.sh's --host-tools takes, so the
console's Wine can be built without waiting for the whole of the PC's.
build_wow64native.sh --ps5-only builds only wow64native.prx, from the
PS5 inputs, without the PC's Wine build: its two halves can be built on
two machines.
---
 tools/build_host_wine.sh   | 15 +++++++++-
 tools/build_wow64native.sh | 56 ++++++++++++++++++++++----------------
 2 files changed, 47 insertions(+), 24 deletions(-)

diff --git a/tools/build_host_wine.sh b/tools/build_host_wine.sh
index 5512be2..cb168fc 100755
--- a/tools/build_host_wine.sh
+++ b/tools/build_host_wine.sh
@@ -15,15 +15,19 @@
 # about 300 MB stripped against 1.5 GB with debug information.
 #
 # Usage:
-#   tools/build_host_wine.sh [--source DIR] [--work DIR] [--jobs N]
+#   tools/build_host_wine.sh [--source DIR] [--work DIR] [--jobs N] [--tools-only]
 # prints the installed wine's path last. --source is a checkout of Wine that
 # has WINE_COMMIT (default .deps/wine/source, as build_wine_ps5.sh).
+# --tools-only builds Wine's own tools alone (make __tooldeps__: winebuild,
+# widl, winegcc and the rest), what build_wine_ps5.sh's --host-tools takes,
+# in minutes, and prints the build directory last; nothing is installed.
 set -eu
 
 root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
 source_dir=${PROSPERO_WINE_SOURCE:-$root/.deps/wine/source}
 work=${PROSPERO_HOST_WINE_WORK:-$root/.deps/wine-host}
 jobs=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)
+tools_only=0
 
 fail() { echo "build_host_wine: $*" >&2; exit 1; }
 while [ $# -gt 0 ]; do
@@ -31,6 +35,7 @@ while [ $# -gt 0 ]; do
     --source) source_dir=$2; shift ;;
     --work) work=$2; shift ;;
     --jobs) jobs=$2; shift ;;
+    --tools-only) tools_only=1 ;;
     *) fail "unknown argument $1" ;;
     esac
     shift
@@ -103,6 +108,14 @@ fi
 # What the PC's Wine could not find is worth knowing: an installer without
 # X11 or FreeType shows nothing, and without Vulkan DXVK cannot be tried.
 grep -E "^configure: (WARNING|OpenGL|Vulkan)|won't be supported" "$work/configure.log" || true
+if [ "$tools_only" = 1 ]; then
+    make -C "$build" -j"$jobs" __tooldeps__ > "$work/make.log" 2>&1 ||
+        fail "the tools' build failed; see $work/make.log"
+    [ -x "$build/tools/winebuild/winebuild" ] || fail "no winebuild in $build/tools"
+    echo "host wine tools: $build/tools"
+    echo "$build"
+    exit 0
+fi
 make -C "$build" -j"$jobs" > "$work/make.log" 2>&1 || fail "the build failed; see $work/make.log"
 
 install=$work/install
diff --git a/tools/build_wow64native.sh b/tools/build_wow64native.sh
index 0b42998..7c23ac4 100755
--- a/tools/build_wow64native.sh
+++ b/tools/build_wow64native.sh
@@ -1,8 +1,10 @@
 #!/bin/sh
 # Build the independent native WoW64 scaffold against an existing pinned Wine build.
+# --ps5-only builds only its PS5 module (ps5/wow64native.prx), from the PS5 inputs alone,
+# with no host Wine build: the Windows half and the PS5 half can then be built apart.
 set -eu
 root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
-source_dir= build_dir= output_dir=
+source_dir= build_dir= output_dir= ps5_only=0
 ps5_sdk= ps5_wine= ps5_ntdll= ps5_foundation= ps5_stubs=
 while [ "$#" -gt 0 ]; do
     case "$1" in
@@ -14,33 +16,41 @@ while [ "$#" -gt 0 ]; do
         --ps5-ntdll) ps5_ntdll=$2; shift 2 ;;
         --ps5-foundation) ps5_foundation=$2; shift 2 ;;
         --ps5-stubs) ps5_stubs=$2; shift 2 ;;
+        --ps5-only) ps5_only=1; shift ;;
         *) echo "usage: $0 --source DIR --build DIR --output DIR" >&2; exit 2 ;;
     esac
 done
 fail() { echo "build_wow64native: $*" >&2; exit 1; }
-[ -n "$source_dir" ] && [ -n "$build_dir" ] && [ -n "$output_dir" ] || fail "all paths are required"
-[ "$(git -C "$source_dir" rev-parse HEAD)" = 490f6d5dcbb2a5047345b8af88d114bbcaad69a8 ] || fail "wrong Wine revision"
-grep -q -- '--enable-archs=i386,x86_64' "$build_dir/config.log" || fail "not a WoW64 configuration"
-[ -x "$build_dir/tools/winegcc/winegcc" ] && [ -f "$build_dir/dlls/ntdll/ntdll.so" ] || fail "prepare the existing Wine build first"
 module=$root/wine/wow64native
-mkdir -p "$output_dir/x86_64-windows" "$output_dir/x86_64-unix"
-out=$(CDPATH= cd -- "$output_dir" && pwd)
-gcc -m64 -O2 -g -fPIC -shared -Wl,-Bsymbolic -Wl,-soname,wow64native.so \
-    -Wl,-z,defs -D__WINESRC__ -DWINE_UNIX_LIB -D_REENTRANT \
-    -I"$module" -I"$build_dir/include" -I"$source_dir/include" \
-    "$module/unix.c" "$build_dir/dlls/ntdll/ntdll.so" -o "$out/x86_64-unix/wow64native.so"
-x86_64-w64-mingw32-gcc -c -o "$out/x86_64-windows/cpu.o" "$module/cpu.c" \
-    -I"$module" -I"$build_dir/include" -I"$source_dir/include" -I"$source_dir/include/msvcrt" \
-    -D_MSVCR_VER=0 -D__WINESRC__ -D__WINE_PE_BUILD -Wall -fno-strict-aliasing \
-    -mcx16 -mcmodel=small -O2 -g -fno-builtin -fshort-wchar
-(cd "$build_dir" && tools/winegcc/winegcc -o "$out/x86_64-windows/wow64native.dll" \
-    --wine-objdir . --cc-cmd=x86_64-w64-mingw32-gcc -b x86_64-w64-mingw32 \
-    -Wl,--wine-builtin -shared "$module/wow64native.spec" -nodefaultlibs \
-    -Wl,--image-base,0x7a400000 "$out/x86_64-windows/cpu.o" \
-    dlls/wow64/x86_64-windows/libwow64.a dlls/ntdll/x86_64-windows/libntdll.a \
-    libs/winecrt0/x86_64-windows/libwinecrt0.a dlls/ntdll/x86_64-windows/libntdll.a \
-    libs/compiler-rt/x86_64-windows/libcompiler-rt.a)
-echo "build_wow64native: scaffold built; native execution requires a compatible ntdll signal bridge"
+if [ "$ps5_only" = 1 ]; then
+    [ -n "$output_dir" ] || fail "--output is required"
+    [ -n "$ps5_sdk" ] || fail "--ps5-only needs the PS5 inputs"
+    mkdir -p "$output_dir"
+    out=$(CDPATH= cd -- "$output_dir" && pwd)
+else
+    [ -n "$source_dir" ] && [ -n "$build_dir" ] && [ -n "$output_dir" ] || fail "all paths are required"
+    [ "$(git -C "$source_dir" rev-parse HEAD)" = 490f6d5dcbb2a5047345b8af88d114bbcaad69a8 ] || fail "wrong Wine revision"
+    grep -q -- '--enable-archs=i386,x86_64' "$build_dir/config.log" || fail "not a WoW64 configuration"
+    [ -x "$build_dir/tools/winegcc/winegcc" ] && [ -f "$build_dir/dlls/ntdll/ntdll.so" ] || fail "prepare the existing Wine build first"
+    mkdir -p "$output_dir/x86_64-windows" "$output_dir/x86_64-unix"
+    out=$(CDPATH= cd -- "$output_dir" && pwd)
+    gcc -m64 -O2 -g -fPIC -shared -Wl,-Bsymbolic -Wl,-soname,wow64native.so \
+        -Wl,-z,defs -D__WINESRC__ -DWINE_UNIX_LIB -D_REENTRANT \
+        -I"$module" -I"$build_dir/include" -I"$source_dir/include" \
+        "$module/unix.c" "$build_dir/dlls/ntdll/ntdll.so" -o "$out/x86_64-unix/wow64native.so"
+    x86_64-w64-mingw32-gcc -c -o "$out/x86_64-windows/cpu.o" "$module/cpu.c" \
+        -I"$module" -I"$build_dir/include" -I"$source_dir/include" -I"$source_dir/include/msvcrt" \
+        -D_MSVCR_VER=0 -D__WINESRC__ -D__WINE_PE_BUILD -Wall -fno-strict-aliasing \
+        -mcx16 -mcmodel=small -O2 -g -fno-builtin -fshort-wchar
+    (cd "$build_dir" && tools/winegcc/winegcc -o "$out/x86_64-windows/wow64native.dll" \
+        --wine-objdir . --cc-cmd=x86_64-w64-mingw32-gcc -b x86_64-w64-mingw32 \
+        -Wl,--wine-builtin -shared "$module/wow64native.spec" -nodefaultlibs \
+        -Wl,--image-base,0x7a400000 "$out/x86_64-windows/cpu.o" \
+        dlls/wow64/x86_64-windows/libwow64.a dlls/ntdll/x86_64-windows/libntdll.a \
+        libs/winecrt0/x86_64-windows/libwinecrt0.a dlls/ntdll/x86_64-windows/libntdll.a \
+        libs/compiler-rt/x86_64-windows/libcompiler-rt.a)
+    echo "build_wow64native: scaffold built; native execution requires a compatible ntdll signal bridge"
+fi
 
 # Optional independent PRX build against an existing PS5 Wine configuration.
 # Every input is explicit; never update the shared Wine stage or deploy a title.
-- 
2.43.0

