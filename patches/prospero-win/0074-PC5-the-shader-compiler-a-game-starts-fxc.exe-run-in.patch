+index 25b3f4f..4f42d83 100644
+--- a/dlls/kernelbase/process.c
++++ b/dlls/kernelbase/process.c
+@@ -683,6 +683,9 @@ BOOL WINAPI DECLSPEC_HOTPATCH CreateProcessInternalW( HANDLE token, const WCHAR
+         if (!(flags & CREATE_SUSPENDED)) NtResumeThread( rtl_info.Thread, NULL );
+         TRACE( "started process pid %04lx tid %04lx\n", info->dwProcessId, info->dwThreadId );
+     }
++    /* A title on the PS5 can't start a second process: a tool done in this process instead */
++    else if (status == STATUS_NOT_SUPPORTED && tool_run( app_name, tidy_cmdline, cur_dir, info ))
++        status = STATUS_SUCCESS;
+ 
+  done:
+     RtlDestroyProcessParameters( params );
+@@ -803,6 +806,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetExitCodeProcess( HANDLE process, LPDWORD exit_c
+ 
+     status = NtQueryInformationProcess( process, ProcessBasicInformation, &pbi, sizeof(pbi), NULL );
+     if (!status && exit_code) *exit_code = pbi.ExitStatus;
++    if (status == STATUS_OBJECT_TYPE_MISMATCH && tool_exit_code( process, exit_code )) status = STATUS_SUCCESS;
+     return set_ntstatus( status );
+ }
