++ * but WITHOUT ANY WARRANTY; without even the implied warranty of
++ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
++ * Lesser General Public License for more details.
++ *
++ * You should have received a copy of the GNU Lesser General Public
++ * License along with this library; if not, write to the Free Software
++ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
++ */
++
++/* A PS5 title is a single process, so CreateProcess fails there with STATUS_NOT_SUPPORTED.
++ * Some games start a tool and wait for the file it writes: Far Cry builds its shaders at start
++ * by running the shader compiler it ships (fxc.exe /T vs_1_1 /Zpr /DCGC=0 /Fc $$out.cg $$in.cg)
++ * and reads the assembly listing back, a hundred times; without it those shaders are missing
++ * and the game draws blurry, repeating textures. When such a start fails, the tool's work is
++ * done here instead, with Wine's d3dcompiler, and the caller gets a process that has already
++ * ended with the tool's exit code: an event, signalled, which GetExitCodeProcess knows. Only
++ * a start that failed is replaced, so where processes can be created nothing changes. */
++
++#include <stdarg.h>
++#include <stdio.h>
++#include <string.h>
++
++#define COBJMACROS
++#include "ntstatus.h"
++#define WIN32_NO_STATUS
++#include "windef.h"
++#include "winbase.h"
++#include "winternl.h"
++#include "d3dcommon.h"
++#include "d3dcompiler.h"
++
++#include "kernelbase.h"
++#include "wine/debug.h"
++
++WINE_DEFAULT_DEBUG_CHANNEL(process);
++
++#define TOOL_EXITS 32
++
++static struct { HANDLE process; DWORD code; } tool_exits[TOOL_EXITS];
++static LONG tool_exit_next;
++
++static void tool_exit_add( HANDLE process, DWORD code )
++{
++    LONG i = (InterlockedIncrement( &tool_exit_next ) - 1) % TOOL_EXITS;
++
++    tool_exits[i].code = code;
++    InterlockedExchangePointer( &tool_exits[i].process, process );
++}
++
++/* the exit code of a tool run here, for GetExitCodeProcess on its handle */
++BOOL tool_exit_code( HANDLE process, DWORD *code )
++{
++    int i;
++
++    if (!process) return FALSE;
++    for (i = 0; i < TOOL_EXITS; i++)
++    {
++        if (tool_exits[i].process != process) continue;
++        if (code) *code = tool_exits[i].code;
++        return TRUE;
++    }
++    return FALSE;
++}
++
++/* the command line's arguments, split as the C runtime splits them (quotes, no escapes) */
++static int split_args( const WCHAR *cmd_line, WCHAR *buffer, WCHAR **args, int max )
++{
++    int count = 0;
++
++    while (*cmd_line && count < max)
++    {
++        BOOL quoted = FALSE;
++
++        while (*cmd_line == ' ' || *cmd_line == '\t') cmd_line++;
++        if (!*cmd_line) break;
++        args[count++] = buffer;
++        while (*cmd_line && (quoted || (*cmd_line != ' ' && *cmd_line != '\t')))
++        {
++            if (*cmd_line == '"') quoted = !quoted;
++            else *buffer++ = *cmd_line;
++            cmd_line++;
++        }
++        *buffer++ = 0;
++    }
++    return count;
++}
++
++static char *to_ansi( const WCHAR *text )
++{
++    int size = WideCharToMultiByte( CP_ACP, 0, text, -1, NULL, 0, NULL, NULL );
++    char *out = size > 0 ? HeapAlloc( GetProcessHeap(), 0, size ) : NULL;
++
++    if (out) WideCharToMultiByte( CP_ACP, 0, text, -1, out, size, NULL, NULL );
++    return out;
++}
++
++/* a file named on the command line, in the folder the tool would have started in */
++static WCHAR *tool_path( const WCHAR *name, const WCHAR *cur_dir )
++{
++    size_t dir = cur_dir ? wcslen( cur_dir ) : 0, len = wcslen( name );
++    WCHAR *out;
++
++    if (!cur_dir || name[0] == '\\' || name[0] == '/' || (name[0] && name[1] == ':')) dir = 0;
++    if (!(out = HeapAlloc( GetProcessHeap(), 0, (dir + len + 2) * sizeof(WCHAR) ))) return NULL;
++    if (dir)
++    {
++        memcpy( out, cur_dir, dir * sizeof(WCHAR) );
++        if (out[dir - 1] != '\\' && out[dir - 1] != '/') out[dir++] = '\\';
++    }
++    memcpy( out + dir, name, (len + 1) * sizeof(WCHAR) );
++    return out;
++}
++
++static void *read_whole( const WCHAR *path, DWORD *size )
++{
++    HANDLE file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
++                               OPEN_EXISTING, 0, NULL );
++    LARGE_INTEGER length;
++    DWORD got = 0;
++    char *data = NULL;
++
++    if (file == INVALID_HANDLE_VALUE) return NULL;
++    if (GetFileSizeEx( file, &length ) && length.QuadPart < (64 << 20) &&
++        (data = HeapAlloc( GetProcessHeap(), 0, length.QuadPart + 1 )) &&
++        ReadFile( file, data, length.QuadPart, &got, NULL ) && got == length.QuadPart)
++    {
++        data[got] = 0;
++        *size = got;
++    }
++    else
++    {
++        HeapFree( GetProcessHeap(), 0, data );
++        data = NULL;
++    }
++    CloseHandle( file );
++    return data;
++}
++
++static BOOL write_whole( const WCHAR *path, const void *data, DWORD size )
++{
++    HANDLE file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
++    DWORD done = 0;
++    BOOL ok;
++
++    if (file == INVALID_HANDLE_VALUE) return FALSE;
++    ok = WriteFile( file, data, size, &done, NULL ) && done == size;
++    CloseHandle( file );
++    return ok;
++}
++
++struct text
++{
++    char *data;
++    size_t size, used;
++};
++
++static void text_add( struct text *text, const char *format, ... )
++{
++    va_list args;
++    int len;
++
++    if (!text->data && !(text->data = HeapAlloc( GetProcessHeap(), 0, (text->size = 4096) ))) return;
++    for (;;)
++    {
++        va_start( args, format );
++        len = _vsnprintf( text->data + text->used, text->size - text->used, format, args );
++        va_end( args );
++        if (len >= 0 && (size_t)len < text->size - text->used) break;
++        if (text->size > (16 << 20)) return;
++        text->data = HeapReAlloc( GetProcessHeap(), 0, text->data, text->size *= 2 );
++        if (!text->data) return;
++    }
++    text->used += len;
++}
++
++/* The constant table compiled code carries (a CTAB comment, D3DXSHADER_CONSTANTTABLE), as fxc
++ * lists it before the code: each constant's type, then its register and size. */
++static const BYTE *find_ctab( const DWORD *code, DWORD size, DWORD *ctab_size )
++{
++    const DWORD *end = code + size / sizeof(DWORD);
++
++    for (code++; code < end; code++)
++    {
++        DWORD length;
++
++        if (*code == 0x0000ffff) break;  /* the end token */
++        if ((*code & 0xffff) != 0xfffe) continue;
++        length = (*code >> 16) & 0x7fff;
++        if (code + 1 + length > end) break;
++        if (length >= 2 && code[1] == 0x42415443 /* CTAB */)
++        {
++            *ctab_size = (length - 1) * sizeof(DWORD);
++            return (const BYTE *)(code + 2);
++        }
++        code += length;
++    }
++    return NULL;
++}
++
++static DWORD u32_at( const BYTE *data, DWORD size, DWORD offset )
++{
++    DWORD value = 0;
++
++    if (offset <= size && size - offset >= sizeof(value)) memcpy( &value, data + offset, sizeof(value) );
++    return value;
++}
++
++static WORD u16_at( const BYTE *data, DWORD size, DWORD offset )
++{
++    WORD value = 0;
++
++    if (offset <= size && size - offset >= sizeof(value)) memcpy( &value, data + offset, sizeof(value) );
++    return value;
++}
++
++static const char *string_at( const BYTE *data, DWORD size, DWORD offset )
++{
++    if (offset >= size || !memchr( data + offset, 0, size - offset )) return "";
++    return (const char *)data + offset;
++}
++
++static void type_name( const BYTE *ctab, DWORD size, DWORD type_offset, char *out, size_t out_size )
++{
++    static const char * const objects[] =
++    {
++        "void", "bool", "int", "float", "string", "texture", "texture1D", "texture2D", "texture3D", "textureCUBE",
++        "sampler", "sampler1D", "sampler2D", "sampler3D", "samplerCUBE",
++    };
++    WORD class = u16_at( ctab, size, type_offset ), type = u16_at( ctab, size, type_offset + 2 );
++    WORD rows = u16_at( ctab, size, type_offset + 4 ), columns = u16_at( ctab, size, type_offset + 6 );
++    const char *base = type < ARRAY_SIZE(objects) ? objects[type] : "float";
++
++    switch (class)
++    {
++    case 1:  /* vector */
++        _snprintf( out, out_size, "%s%u", base, columns );
++        break;
++    case 2:  /* matrix, rows */
++        _snprintf( out, out_size, "row_major %s%ux%u", base, rows, columns );
++        break;
++    case 3:  /* matrix, columns */
++        _snprintf( out, out_size, "%s%ux%u", base, rows, columns );
++        break;
++    case 5:  /* struct */
++        _snprintf( out, out_size, "struct" );
++        break;
++    default:  /* scalar or object */
++        _snprintf( out, out_size, "%s", base );
++        break;
++    }
++}
++
++static void list_constants( struct text *text, const BYTE *ctab, DWORD size )
++{
++    static const char sets[] = "bics";
++    DWORD count = u32_at( ctab, size, 12 ), info = u32_at( ctab, size, 16 ), i;
++    size_t width = 4;
++    char type[64];
++
++    if (count > 4096) count = 0;
++    text_add( text, "//\n// Parameters:\n//\n" );
++    for (i = 0; i < count; i++)
++    {
++        DWORD entry = info + i * 20;
++        const char *name = string_at( ctab, size, u32_at( ctab, size, entry ) );
++        DWORD type_offset = u32_at( ctab, size, entry + 12 );
++        WORD elements = u16_at( ctab, size, type_offset + 8 );
++
++        type_name( ctab, size, type_offset, type, sizeof(type) );
++        if (elements > 1) text_add( text, "//   %s %s[%u];\n", type, name, elements );
++        else text_add( text, "//   %s %s;\n", type, name );
++        if (strlen( name ) > width) width = strlen( name );
++    }
++    text_add( text, "//\n//\n// Registers:\n//\n//   %-*s Reg   Size\n//   ", (int)width, "Name" );
++    for (i = 0; i < width; i++) text_add( text, "-" );
++    text_add( text, " ----- ----\n" );
++    for (i = 0; i < count; i++)
++    {
++        DWORD entry = info + i * 20;
++        const char *name = string_at( ctab, size, u32_at( ctab, size, entry ) );
++        WORD set = u16_at( ctab, size, entry + 4 ), index = u16_at( ctab, size, entry + 6 );
++        WORD registers = u16_at( ctab, size, entry + 8 );
++        char reg[16];
++
++        _snprintf( reg, sizeof(reg), "%c%u", set < 4 ? sets[set] : 'c', index );
++        text_add( text, "//   %-*s %-5s %4u\n", (int)width, name, reg, registers );
++    }
++    text_add( text, "//\n" );
++}
++
++typedef HRESULT (WINAPI *compile_func)( const void *data, SIZE_T size, const char *filename,
++                                        const D3D_SHADER_MACRO *defines, ID3DInclude *include,
++                                        const char *entrypoint, const char *target, UINT flags,
++                                        UINT effect_flags, ID3DBlob **shader, ID3DBlob **errors );
++typedef HRESULT (WINAPI *disassemble_func)( const void *data, SIZE_T size, UINT flags, const char *comments,
++                                            ID3DBlob **disassembly );
++
++#define FXC_ARGS    64
++#define FXC_DEFINES 32
++
++/* fxc.exe's work: the options a game gives it, the file it compiles, the listing (/Fc) and the
++ * code (/Fo) it writes. Returns its exit code: 0 when it compiled, 1 otherwise. */
++static DWORD run_fxc( const WCHAR *cmd_line, const WCHAR *cur_dir )
++{
++    static compile_func compile;
++    static disassemble_func disassemble;
++    D3D_SHADER_MACRO defines[FXC_DEFINES + 1] = {{ 0 }};
++    WCHAR *buffer, *args[FXC_ARGS], *input = NULL, *listing = NULL, *object = NULL;
++    char *profile = NULL, *entry = NULL, *source = NULL, *source_name = NULL, *macros[FXC_DEFINES] = { 0 };
++    ID3DBlob *code = NULL, *errors = NULL, *assembly = NULL;
++    UINT flags = D3DCOMPILE_ENABLE_BACKWARDS_COMPATIBILITY;
++    int count, i, defined = 0;
++    DWORD source_size = 0, result = 1;
++    WCHAR *path;
++    HRESULT hr;
++
++    if (!compile)
++    {
++        HMODULE module = LoadLibraryW( L"d3dcompiler_47.dll" );
++
++        if (!module || !(disassemble = (disassemble_func)GetProcAddress( module, "D3DDisassemble" )) ||
++            !(compile = (compile_func)GetProcAddress( module, "D3DCompile" )))
++        {
++            ERR( "fxc: no d3dcompiler_47\n" );
++            return 1;
++        }
++    }
++
++    if (!(buffer = HeapAlloc( GetProcessHeap(), 0, (wcslen( cmd_line ) + 1) * sizeof(WCHAR) ))) return 1;
++    count = split_args( cmd_line, buffer, args, FXC_ARGS );
++    for (i = 1; i < count; i++)
++    {
++        WCHAR *arg = args[i], *value = NULL;
++
++        if (arg[0] != '/' && arg[0] != '-')
++        {
++            input = arg;
++            continue;
++        }
++        arg++;
++#define OPTION(name) (!wcsnicmp( arg, name, wcslen( name ) ) && \
++                      (value = arg[wcslen( name )] ? arg + wcslen( name ) : (i + 1 < count ? args[++i] : NULL)))
++        if (!wcsicmp( arg, L"Zpr" )) flags |= D3DCOMPILE_PACK_MATRIX_ROW_MAJOR;
++        else if (!wcsicmp( arg, L"Zpc" )) flags |= D3DCOMPILE_PACK_MATRIX_COLUMN_MAJOR;
++        else if (!wcsicmp( arg, L"Od" )) flags |= D3DCOMPILE_SKIP_OPTIMIZATION;
++        else if (!wcsicmp( arg, L"Vd" )) flags |= D3DCOMPILE_SKIP_VALIDATION;
++        else if (!wcsicmp( arg, L"Gpp" )) flags |= D3DCOMPILE_PARTIAL_PRECISION;
++        else if (!wcsicmp( arg, L"Zi" )) flags |= D3DCOMPILE_DEBUG;
++        else if (!wcsicmp( arg, L"nologo" ) || !wcsnicmp( arg, L"O", 1 ) || !wcsnicmp( arg, L"G", 1 )) continue;
++        else if (OPTION( L"Fc" )) listing = value;
++        else if (OPTION( L"Fo" )) object = value;
++        else if (OPTION( L"T" )) profile = to_ansi( value );
++        else if (OPTION( L"E" )) entry = to_ansi( value );
++        else if (OPTION( L"D" ))
++        {
