+--- /dev/null
++++ b/dlls/kernelbase/tool.c
+@@ -0,0 +1,500 @@
++/*
++ * A tool program run in this process where no second process can be started
++ *
++ * Copyright 2026 bornaradusin
++ *
++ * This library is free software; you can redistribute it and/or
++ * modify it under the terms of the GNU Lesser General Public
