+index 2e33b6b..0156ae0 100644
+--- a/dlls/kernelbase/Makefile.in
++++ b/dlls/kernelbase/Makefile.in
+@@ -23,6 +23,7 @@ SOURCES = \
+ 	string.c \
+ 	sync.c \
+ 	thread.c \
++	tool.c \
+ 	version.c \
+ 	volume.c \
+ 	winerror.mc
